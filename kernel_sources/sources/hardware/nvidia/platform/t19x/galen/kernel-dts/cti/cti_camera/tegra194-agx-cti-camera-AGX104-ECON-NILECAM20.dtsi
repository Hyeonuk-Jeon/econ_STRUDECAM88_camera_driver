#include "dt-bindings/clock/tegra194-clock.h"

#define CAM0_RST_L	TEGRA194_MAIN_GPIO(H, 3)
#define CAM1_RST_L	TEGRA194_MAIN_GPIO(T, 6)


#define CAMERA_I2C_MUX_BUS(x) (0x1E + x)
#define CAM_LANES 4
#define CAM_LANES_STRING "4" 
#define TEGRA_SINTERFACE "serial_g"
#define MODE_VC "0"
#define SERDES_PIX_CLK_HZ "480000000" 
					

/ {
	gpio@2200000 {
		camera-control-output-high {
			status = "okay";
			gpio-hog;
			gpios = <CAM1_RST_L 0>;
			output-high;
			label = "rst-io-expander"; 
		};
		camera-control-output-low {
			status = "okay";
			gpio-hog;
			gpios = <CAM0_RST_L 0>;
			output-low;
			label = "trigger_sel";
		};
	};

	i2c@3180000 {
		status = "okay";
		#address-cells = <1>;
		#size-cells = <0>;
	
		tca9544@70 {
		status = "okay";
		compatible = "nxp,pca9544";
		reg = <0x70>;
		#address-cells = <1>;
		#size-cells = <0>;
		vcc-supply = <&vdd_1v8_cvb>;
		vcc-pullup-supply = <&battery_reg>;
		vcc_lp = "vcc";
		skip_mux_detect = "yes";
		force_bus_start = <40>;
		i2c@0 {
			status = "okay";
			reg = <0>;
			i2c-mux,deselect-on-exit;
			#address-cells = <1>;
			#size-cells = <0>;
			ar0234_a@43 {
				status = "okay";
				compatible = "nvidia,ar0230";
				reg = <0x43>;
				sensor_mode = "ar0230";
				avdd-reg = "vana";
				iovdd-reg = "vif";
				clocks = <&bpmp_clks TEGRA194_CLK_EXTPERIPH1>,<&bpmp_clks TEGRA194_CLK_EXTPERIPH1>;
				clock-names = "extperiph1","pllp_grtba";
				mclk = "extperiph1";
				clock-frequency = <24000000>;
				default-trigger = "internal";
				vif-supply = <&vdd_1v8_cvb>;
				use_sensor_mode_id = "false";
				camera_mipi_lanes = <CAM_LANES>;
				camera-mipi-clk = <1200>;
				sio-port = "A";
				reset-gpios = <&tca9539_74 0 0>;
				boot-gpios = <&tca9539_74 1 0>;
				trigger-gpios = <&tca9539_74 10 GPIO_ACTIVE_LOW>;
#undef LOCAL_VC_ID
#define LOCAL_VC_ID "1"
#undef TEGRA_SINTERFACE
#define TEGRA_SINTERFACE "serial_a"
#include "nilecam20_cuxvr_mode.dtsi"
				ports {
					#address-cells = <1>;
					#size-cells = <0>;
