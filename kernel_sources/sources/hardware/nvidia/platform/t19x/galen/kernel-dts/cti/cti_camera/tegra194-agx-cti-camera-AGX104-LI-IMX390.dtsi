/ {
    tegra-camera-platform {
		compatible = "nvidia, tegra-camera-platform";
		num_csi_lanes = <16>;
		max_lane_speed = <1500000>;
		min_bits_per_pixel = <8>;
		vi_peak_byte_per_pixel = <2>;
		vi_bw_margin_pct = <25>;
		max_pixel_rate = <160000>;
		isp_peak_byte_per_pixel = <5>;
		isp_bw_margin_pct = <25>;
        
		modules {
			status = "okay";
			module0 {
				status = "okay";
				badge = "imx390_bottomleft_liimx390";
				position = "bottomleft";
				orientation = "1";
				drivernode0 {
					status = "okay";
					pcl_id = "v4l2_sensor";
					devname = "li-nv_imx390 40-001b";
					proc-device-tree = "/proc/device-tree/i2c@3180000/tca9544@70/i2c@0/imx390_a@1b";
				};

			};
			module1 {
				status = "okay";
