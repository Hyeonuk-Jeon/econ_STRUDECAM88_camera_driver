#include "dt-bindings/clock/tegra194-clock.h"

#define CAM0_RST_L	TEGRA194_MAIN_GPIO(H, 3)
#define CAM1_RST_L	TEGRA194_MAIN_GPIO(T, 6)

#define CAMERA_I2C_MUX_BUS(x) (0x1E + x)
#define CAM_LANES 4
#define CAM_LANES_STRING "4" 
#define TEGRA_SINTERFACE "serial_g"
#define MODE_VC "0"
#define SERDES_PIX_CLK_HZ "480000000" 
//"590000000"

                                        
#define IMX390_MODE0 \
		mclk_khz = "24000"; \
		discontinuous_clk = "no"; \
		dpcm_enable = "false"; \
		cil_settletime = "0"; \
		dynamic_pixel_bit_depth = "12"; \
		csi_pixel_bit_depth = "12"; \
		mode_type = "bayer"; \
		pixel_phase = "rggb"; \
		active_w = "1920"; \
		active_h = "1080"; \
		readout_orientation = "0"; \
		line_length = "2200"; \
		inherent_gain = "1"; \
		pix_clk_hz = "74250000"; \
		serdes_pix_clk_hz = SERDES_PIX_CLK_HZ; \
		gain_factor = "10"; \
		min_gain_val = "0";  \
		max_gain_val = "300"; \
		step_gain_val = "3"; \
		default_gain = "0"; \
		min_hdr_ratio = "1"; \
		max_hdr_ratio = "1"; \
		framerate_factor = "1000000"; \
		min_framerate = "30000000"; \
		max_framerate = "30000000"; \
		step_framerate = "1"; \
		default_framerate = "30000000"; \
		exposure_factor = "1000000"; \
		min_exp_time = "118"; \
		max_exp_time = "33333"; \
		step_exp_time = "1"; \
		default_exp_time = "33333"; \
		embedded_metadata_height = "0"; \

/ {
	gpio@2200000 {
		camera-control-output-high {
			status = "okay";
			gpio-hog;
			gpios = <CAM1_RST_L 0>;
			output-high;
			label = "rst-io-expander"; 
		};
		camera-control-output-low {
			status = "okay";
			gpio-hog;
			gpios = <CAM0_RST_L 0>;
			output-low;
			label = "trigger_sel";
		};
	};

	i2c@3180000 {
		status = "okay";
		#address-cells = <1>;
		#size-cells = <0>;
        
		tca9544@70 {
	    	status = "okay";
	    	compatible = "nxp,pca9544";
	    	reg = <0x70>;
	    	#address-cells = <1>;
	    	#size-cells = <0>;
	    	vcc-supply = <&vdd_1v8_cvb>;
	    	vcc-pullup-supply = <&battery_reg>;
	    	vcc_lp = "vcc";
	    	skip_mux_detect = "yes";
	    	force_bus_start = <40>;
        	i2c@0 {
        	    status = "okay";
				reg = <0>;
				i2c-mux,deselect-on-exit;
				#address-cells = <1>;
				#size-cells = <0>;

				dsera: li_max9296@48 {
					compatible = "li,li_max9296";
					reg = <0x48>;
					csi-mode = "2x4";
					max-src = <2>;
					status = "okay";
					reset-gpios = <&tca9539_74 0 GPIO_ACTIVE_HIGH>;
					//reset-gpios
				};
				ser_prima: li_max9295_prim@62 {
					compatible = "li,li_max9295";
					reg = <0x62>;
					is-prim-ser;
					status = "okay";
				};
				ser_a0: li_max9295_a@40 {
					compatible = "li,li_max9295";
					reg = <0x40>;
					nvidia,gmsl-dser-device = <&dsera>;
					status = "okay";
				};

				ser_b0: li_max9295_b@60 {
					compatible = "li,li_max9295";
					reg = <0x60>;
					nvidia,gmsl-dser-device = <&dsera>;
					status = "okay";
				};

				imx390_a@1b {
					def-addr = <0x21>;
					clocks = <&bpmp_clks TEGRA194_CLK_EXTPERIPH1>, <&bpmp_clks TEGRA194_CLK_EXTPERIPH1>;
					clock-names = "extperiph1", "pllp_grtba";
					mclk = "extperiph1";
					nvidia,gmsl-ser-device = <&ser_a0>;
					nvidia,gmsl-dser-device = <&dsera>;
					compatible = "li,imx390";
					reg = <0x1b>;
					reg_mux = <0>;

					physical_w = "15.0";
					physical_h = "12.5";
					sensor_model = "imx390";
					post_crop_frame_drop = "0";
					use_decibel_gain = "true";
					use_sensor_mode_id = "true";

					status = "okay";

					mode0 {
						IMX390_MODE0
						tegra_sinterface = "serial_a";
						num_lanes = "4";
						//mode_lanes = <4>;
						vc_id = "0";
					};

					ports {
						#address-cells = <1>;
						#size-cells = <0>;
						port@0{
							reg = <0>;
							cam_out0: endpoint {
								vc-id = <0>;
								port-index = <6>;
								bus-width = <CAM_LANES>;
								remote-endpoint = <&csi_in0>;

							};
						};
					};
					gmsl-link {
						src-csi-port = "b";
						dst-csi-port = "a";
						serdes-csi-link = "a";
						csi-mode = "1x4";
						st-vc = <0>;
						vc-id = <0>;
						num-lanes = <CAM_LANES>;
						streams = "ued-u1","raw12";

					};
				};

				imx390_b@1c {
					def-addr = <0x21>;
					clocks = <&bpmp_clks TEGRA194_CLK_EXTPERIPH1>, <&bpmp_clks TEGRA194_CLK_EXTPERIPH1>;
					clock-names = "extperiph1", "pllp_grtba";
					mclk = "extperiph1";
					compatible = "li,imx390";
					nvidia,gmsl-ser-device = <&ser_b0>;
					nvidia,gmsl-dser-device = <&dsera>;
					reg = <0x1c>;
					reg_mux = <0>;

					physical_w = "15.0";
					physical_h = "12.5";
					sensor_model = "imx390";
					post_crop_frame_drop = "0";
					use_decibel_gain = "true";
					use_sensor_mode_id = "true";

					status = "okay";
					mode0 {
						IMX390_MODE0
						tegra_sinterface = "serial_a";
						num_lanes = "4";
						//mode_lanes = <4>;
						vc_id = "1";
					};
					ports {
						#address-cells = <1>;
						#size-cells = <0>;
						port@0{
							reg = <0>;
							cam_out1: endpoint {
								vc-id = <0>;
								port-index = <6>;
								bus-width = <CAM_LANES>;
								remote-endpoint = <&csi_in1>;

							};
						};
					};
					gmsl-link {
						src-csi-port = "b";
						dst-csi-port = "a";
						serdes-csi-link = "b";
						csi-mode = "1x4";
						st-vc = <0>;
						vc-id = <1>;
						num-lanes = <CAM_LANES>;
						streams = "ued-u1","raw12";

					};
				};
        	};

	    	i2c@1 {
				status = "okay";
				reg = <1>;
				i2c-mux,deselect-on-exit;
				#address-cells = <1>;
				#size-cells = <0>;
				dserb: li_max9296@48 {
					compatible = "li,li_max9296";
					reg = <0x48>;
					csi-mode = "2x4";
					max-src = <2>;
					status = "okay";
					reset-gpios = <&tca9539_74 2 GPIO_ACTIVE_HIGH>;
				};
				ser_primb: li_max9295_prim@62 {
					compatible = "li,li_max9295";
					reg = <0x62>;
					is-prim-ser;
					status = "okay";
				};
				ser_a1: li_max9295_a@40 {
					compatible = "li,li_max9295";
					reg = <0x40>;
					nvidia,gmsl-dser-device = <&dserb>;
					status = "okay";
				};

				ser_b1: li_max9295_b@60 {
					compatible = "li,li_max9295";
					reg = <0x60>;
					nvidia,gmsl-dser-device = <&dserb>;
					status = "okay";
				};

				imx390_c@1b {
					def-addr = <0x21>;
					clocks = <&bpmp_clks TEGRA194_CLK_EXTPERIPH1>, <&bpmp_clks TEGRA194_CLK_EXTPERIPH1>;
					clock-names = "extperiph1", "pllp_grtba";
					mclk = "extperiph1";
					nvidia,gmsl-ser-device = <&ser_a1>;
					nvidia,gmsl-dser-device = <&dserb>;
					compatible = "li,imx390";
					reg = <0x1b>;
					reg_mux = <1>;

					physical_w = "15.0";
					physical_h = "12.5";
					sensor_model = "imx390";
					post_crop_frame_drop = "0";
					use_decibel_gain = "true";
					use_sensor_mode_id = "true";

					status = "okay";

					mode0 {
						IMX390_MODE0
						tegra_sinterface = "serial_c";
						num_lanes = "4";
						//mode_lanes = <4>;
						vc_id = "0";
					};

					ports {
						#address-cells = <1>;
						#size-cells = <0>;
						port@0{
							reg = <0>;
							cam_out2: endpoint {
								vc-id = <0>;
								port-index = <4>;
								bus-width = <CAM_LANES>;
								remote-endpoint = <&csi_in2>;

							};
						};
					};
					gmsl-link {
						src-csi-port = "b";
						dst-csi-port = "a";
						serdes-csi-link = "a";
						csi-mode = "1x4";
						st-vc = <0>;
						vc-id = <0>;
						num-lanes = <CAM_LANES>;
						streams = "ued-u1","raw12";

					};
				};

				imx390_d@1c {
					def-addr = <0x21>;
					clocks = <&bpmp_clks TEGRA194_CLK_EXTPERIPH1>, <&bpmp_clks TEGRA194_CLK_EXTPERIPH1>;
					clock-names = "extperiph1", "pllp_grtba";
					mclk = "extperiph1";
					compatible = "li,imx390";
					nvidia,gmsl-ser-device = <&ser_b1>;
					nvidia,gmsl-dser-device = <&dserb>;
					reg = <0x1c>;
					reg_mux = <1>;

					physical_w = "15.0";
					physical_h = "12.5";
					sensor_model = "imx390";
					post_crop_frame_drop = "0";
					use_decibel_gain = "true";
					use_sensor_mode_id = "true";

					status = "okay";
					mode0 {
						IMX390_MODE0
						tegra_sinterface = "serial_c";
						num_lanes = "4";
						//mode_lanes = <4>;
						vc_id = "1";
					};
					ports {
						#address-cells = <1>;
						#size-cells = <0>;
						port@0{
							reg = <0>;
							cam_out3: endpoint {
								vc-id = <1>;
								port-index = <4>;
								bus-width = <CAM_LANES>;
								remote-endpoint = <&csi_in3>;

							};
						};
					};
					gmsl-link {
						src-csi-port = "b";
						dst-csi-port = "a";
						serdes-csi-link = "b";
						csi-mode = "1x4";
						st-vc = <0>;
						vc-id = <1>;
						num-lanes = <CAM_LANES>;
						streams = "ued-u1","raw12";

					};
				};
	    	};


        	i2c@2 {
        	    status = "okay";
        	    reg = <2>;
				i2c-mux,deselect-on-exit;
				#address-cells = <1>;
				#size-cells = <0>;

				dserc: li_max9296@48 {
					compatible = "li,li_max9296";
					reg = <0x48>;
					csi-mode = "2x4";
					max-src = <2>;
					status = "okay";
					reset-gpios = <&tca9539_74 4 GPIO_ACTIVE_HIGH>;
				};
				ser_primc: li_max9295_prim@62 {
					compatible = "li,li_max9295";
					reg = <0x62>;
					is-prim-ser;
					status = "okay";
				};
				ser_a2: li_max9295_a@40 {
					compatible = "li,li_max9295";
					reg = <0x40>;
					nvidia,gmsl-dser-device = <&dserc>;
					status = "okay";
				};

				ser_b2: li_max9295_b@60 {
					compatible = "li,li_max9295";
					reg = <0x60>;
					nvidia,gmsl-dser-device = <&dserc>;
					status = "okay";
				};

				imx390_e@1b {
					def-addr = <0x21>;
					clocks = <&bpmp_clks TEGRA194_CLK_EXTPERIPH1>, <&bpmp_clks TEGRA194_CLK_EXTPERIPH1>;
					clock-names = "extperiph1", "pllp_grtba";
					mclk = "extperiph1";
					nvidia,gmsl-ser-device = <&ser_a2>;
					nvidia,gmsl-dser-device = <&dserc>;
					compatible = "li,imx390";
					reg = <0x1b>;
					reg_mux = <2>;

					physical_w = "15.0";
					physical_h = "12.5";
					sensor_model = "imx390";
					post_crop_frame_drop = "0";
					use_decibel_gain = "true";
					use_sensor_mode_id = "true";

					status = "okay";

					mode0 {
						IMX390_MODE0
						tegra_sinterface = "serial_e";
						num_lanes = "4";
						//mode_lanes = <4>;
						vc_id = "0";
					};

					ports {
						#address-cells = <1>;
						#size-cells = <0>;
						port@0{
							reg = <0>;
							cam_out4: endpoint {
								vc-id = <0>;
								port-index = <2>;
								bus-width = <CAM_LANES>;
								remote-endpoint = <&csi_in4>;

							};
						};
					};
					gmsl-link {
						src-csi-port = "b";
						dst-csi-port = "a";
						serdes-csi-link = "a";
						csi-mode = "1x4";
						st-vc = <0>;
						vc-id = <0>;
						num-lanes = <CAM_LANES>;
						streams = "ued-u1","raw12";

					};
				};

				imx390_f@1c {
					def-addr = <0x21>;
					clocks = <&bpmp_clks TEGRA194_CLK_EXTPERIPH1>, <&bpmp_clks TEGRA194_CLK_EXTPERIPH1>;
					clock-names = "extperiph1", "pllp_grtba";
					mclk = "extperiph1";
					compatible = "li,imx390";
					nvidia,gmsl-ser-device = <&ser_b2>;
					nvidia,gmsl-dser-device = <&dserc>;
					reg = <0x1c>;
					reg_mux = <2>;

					physical_w = "15.0";
					physical_h = "12.5";
					sensor_model = "imx390";
					post_crop_frame_drop = "0";
					use_decibel_gain = "true";
					use_sensor_mode_id = "true";

					status = "okay";
					mode0 {
						IMX390_MODE0
						tegra_sinterface = "serial_e";
						num_lanes = "4";
						//mode_lanes = <4>;
						vc_id = "1";
					};
					ports {
						#address-cells = <1>;
						#size-cells = <0>;
						port@0{
							reg = <0>;
							cam_out5: endpoint {
								vc-id = <1>;
								port-index = <2>;
								bus-width = <CAM_LANES>;
								remote-endpoint = <&csi_in5>;

							};
						};
					};
					gmsl-link {
						src-csi-port = "b";
						dst-csi-port = "a";
						serdes-csi-link = "b";
						csi-mode = "1x4";
						st-vc = <0>;
						vc-id = <1>;
						num-lanes = <CAM_LANES>;
						streams = "ued-u1","raw12";

					};
				};
        	};
	
        	i2c@3 {
        	    status = "okay";
				reg = <3>;
				i2c-mux,deselect-on-exit;
				#address-cells = <1>;
				#size-cells = <0>;
				dserd: li_max9296@48 {
					compatible = "li,li_max9296";
					reg = <0x48>;
					csi-mode = "2x4";
					max-src = <2>;
					status = "okay";
					reset-gpios = <&tca9539_74 6 GPIO_ACTIVE_HIGH>;
				};
				ser_primd: li_max9295_prim@62 {
					compatible = "li,li_max9295";
					reg = <0x62>;
					is-prim-ser;
					status = "okay";
				};
				ser_a3: li_max9295_a@40 {
					compatible = "li,li_max9295";
					reg = <0x40>;
					nvidia,gmsl-dser-device = <&dserd>;
					status = "okay";
				};

				ser_b3: li_max9295_b@60 {
					compatible = "li,li_max9295";
					reg = <0x60>;
					nvidia,gmsl-dser-device = <&dserd>;
					status = "okay";
				};

				imx390_g@1b {
					def-addr = <0x21>;
					clocks = <&bpmp_clks TEGRA194_CLK_EXTPERIPH1>, <&bpmp_clks TEGRA194_CLK_EXTPERIPH1>;
					clock-names = "extperiph1", "pllp_grtba";
					mclk = "extperiph1";
					nvidia,gmsl-ser-device = <&ser_a3>;
					nvidia,gmsl-dser-device = <&dserd>;
					compatible = "li,imx390";
					reg = <0x1b>;
					reg_mux = <3>;

					physical_w = "15.0";
					physical_h = "12.5";
					sensor_model = "imx390";
					post_crop_frame_drop = "0";
					use_decibel_gain = "true";
					use_sensor_mode_id = "true";

					status = "okay";

					mode0 {
						IMX390_MODE0
						tegra_sinterface = "serial_g";
						num_lanes = "4";
						//mode_lanes = <4>;
						vc_id = "0";
					};

					ports {
						#address-cells = <1>;
						#size-cells = <0>;
						port@0{
							reg = <0>;
							cam_out6: endpoint {
								vc-id = <0>;
								port-index = <0>;
								bus-width = <CAM_LANES>;
								remote-endpoint = <&csi_in6>;

							};
						};
					};
					gmsl-link {
						src-csi-port = "b";
						dst-csi-port = "a";
						serdes-csi-link = "a";
						csi-mode = "1x4";
						st-vc = <0>;
						vc-id = <0>;
						num-lanes = <CAM_LANES>;
						streams = "ued-u1","raw12";

					};
				};

				imx390_h@1c {
					def-addr = <0x21>;
					clocks = <&bpmp_clks TEGRA194_CLK_EXTPERIPH1>, <&bpmp_clks TEGRA194_CLK_EXTPERIPH1>;
					clock-names = "extperiph1", "pllp_grtba";
					mclk = "extperiph1";
					compatible = "li,imx390";
					nvidia,gmsl-ser-device = <&ser_b3>;
					nvidia,gmsl-dser-device = <&dserd>;
					reg = <0x1c>;
					reg_mux = <3>;

					physical_w = "15.0";
					physical_h = "12.5";
					sensor_model = "imx390";
					post_crop_frame_drop = "0";
					use_decibel_gain = "true";
					use_sensor_mode_id = "true";

					status = "okay";
					mode0 {
						IMX390_MODE0
						tegra_sinterface = "serial_g";
						num_lanes = "4";
						//mode_lanes = <4>;
						vc_id = "1";
					};
					ports {
						#address-cells = <1>;
						#size-cells = <0>;
						port@0{
							reg = <0>;
							cam_out7: endpoint {
								vc-id = <1>;
								port-index = <0>;
								bus-width = <CAM_LANES>;
