#include "tegra234-orin-nx-cti-NGX020-FSM-4CAM-base.dtsi"
#include "tegra234-cti-fsm-imx715-modes-header.dtsi"

#include "dt-bindings/clock/tegra234-clock.h"

/ {

    i2c@3180000 {
		tca9548@70 {
			status = "okay";	
			i2c@0 {
				status = "okay";
				imx715_a@1a{
					status  = "okay";							
					devnode = "video0";
								
                    reset-gpios = <&gpio_i2c_cam CAM0_RST_0 GPIO_ACTIVE_HIGH>;
					pwdn-gpios = <&tegra_main_gpio CAM0_PWDN GPIO_ACTIVE_HIGH>;
                    
                    SENSOR_COMMON

#define LANE_POLARITY I2C0_LANEPOLARITY
#define TEGRA_SINTERFACE I2C0_SINTERFACE

                    SENSOR_MODE0_2LANE
                    SENSOR_MODE1_2LANE
                    SENSOR_MODE2_2LANE
                    SENSOR_MODE3_2LANE
                    SENSOR_MODE4_2LANE

                    ports {
                        #address-cells = <1>;
                        #size-cells = <0>;
                        port@0 {
                            reg = <0>;
                            vi_out0: endpoint {
                                port-index = VI_CSI_PORT_INDEX0;
                                bus-width = BUS_WIDTH_INDEX0;
                                remote-endpoint = <&csi_in0>;
                            };
                        };
                    };
                };
            };

            i2c@1 {
                status = "okay";
                imx715_c@1a {
                    status = "okay";
                    devnode = "video2";

                    reset-gpios = <&gpio_i2c_cam CAM1_RST_0 GPIO_ACTIVE_HIGH>;
					pwdn-gpios = <&tegra_main_gpio CAM1_PWDN GPIO_ACTIVE_HIGH>;
								
                    SENSOR_COMMON

#undef LANE_POLARITY
#undef TEGRA_SINTERFACE
#define LANE_POLARITY I2C1_LANEPOLARITY
#define TEGRA_SINTERFACE I2C1_SINTERFACE

                    SENSOR_MODE0_4LANE
                    SENSOR_MODE1_4LANE
                    SENSOR_MODE2_4LANE
                    SENSOR_MODE3_4LANE
                    SENSOR_MODE4_4LANE

                    ports {
					    #address-cells = <1>;
						#size-cells = <0>;
						port@0 {
							reg = <0>;
							vi_out1: endpoint {
								port-index = VI_CSI_PORT_INDEX1;
								bus-width = BUS_WIDTH_INDEX1;
                                remote-endpoint = <&csi_in1>;
							};
						};
					};
                };
            };

            i2c@2 {
                status = "okay";
                imx715_d@1a {
                    status = "okay";
                    devnode = "video4";

                    reset-gpios = <&gpio_i2c_cam CAM2_RST_0 GPIO_ACTIVE_HIGH>;
					pwdn-gpios = <&tegra_main_gpio CAM2_PWDN_0 GPIO_ACTIVE_HIGH>;
								
                    SENSOR_COMMON

#undef LANE_POLARITY
#undef TEGRA_SINTERFACE
#define LANE_POLARITY I2C2_LANEPOLARITY
#define TEGRA_SINTERFACE I2C2_SINTERFACE

                    SENSOR_MODE0_4LANE
                    SENSOR_MODE1_4LANE
                    SENSOR_MODE2_4LANE
                    SENSOR_MODE3_4LANE
                    SENSOR_MODE4_4LANE

                    ports {
					    #address-cells = <1>;
						#size-cells = <0>;
						port@0 {
							reg = <0>;
							vi_out2: endpoint {
								port-index = VI_CSI_PORT_INDEX1;
								bus-width = BUS_WIDTH_INDEX2;
                                remote-endpoint = <&csi_in2>;
							};
						};
					};
                };
            };

            i2c@3 {
                status = "okay";
                imx715_e@1a {
                    status = "okay";
                    devnode = "video6";

                    reset-gpios = <&gpio_i2c_cam CAM3_RST_0 GPIO_ACTIVE_HIGH>;
					pwdn-gpios = <&tegra_main_gpio CAM3_PWDN_0 GPIO_ACTIVE_HIGH>;
								
                    SENSOR_COMMON

#undef LANE_POLARITY
#undef TEGRA_SINTERFACE
#define LANE_POLARITY I2C3_LANEPOLARITY
#define TEGRA_SINTERFACE I2C3_SINTERFACE

                    SENSOR_MODE0_4LANE
                    SENSOR_MODE1_4LANE
                    SENSOR_MODE2_4LANE
                    SENSOR_MODE3_4LANE
                    SENSOR_MODE4_4LANE

                    ports {
					    #address-cells = <1>;
						#size-cells = <0>;
						port@0 {
							reg = <0>;
							vi_out3: endpoint {
								port-index = VI_CSI_PORT_INDEX3;
								bus-width = BUS_WIDTH_INDEX3;
                                remote-endpoint = <&csi_in3>;
							};
						};
					};
                };
            };
        };
    };

    tegra-camera-platform {
		modules {
			module0 {
				badge = "imx715_bottomleft_framos";
				position = "bottomleft";
				orientation = "1";
				status = "okay";
				drivernode0 {
					status = "okay";
					pcl_id = "v4l2_sensor";
					devname = "imx715 30-001a";
					proc-device-tree = "/proc/device-tree/i2c@3180000/tca9548@70/i2c@0/imx715_a@1a";
				};
			};
			module1 {
				badge = "imx715_centerright_framos";
				position = "centerright";
				orientation = "1";
				status = "okay";
				drivernode0 {
					status = "okay";
					pcl_id = "v4l2_sensor";
					devname = "imx715 31-001a";
					proc-device-tree = "/proc/device-tree/i2c@3180000/tca9548@70/i2c@1/imx715_c@1a";
				};
			};
			module2 {
				badge = "imx715_bottomright_framos";
				position = "bottomright";
				orientation = "1";
				status = "okay";
				drivernode0 {
					status = "okay";
					pcl_id = "v4l2_sensor";
					devname = "imx715 32-001a";
					proc-device-tree = "/proc/device-tree/i2c@3180000/tca9548@70/i2c@2/imx715_d@1a";
				};
			};
			module3 {
				badge = "imx715_topright_framos";
				position = "topright";
				orientation = "1";
				status = "okay";
				drivernode0 {
					status = "okay";
					pcl_id = "v4l2_sensor";
					devname = "imx715 33-001a";
					proc-device-tree = "/proc/device-tree/i2c@3180000/tca9548@70/i2c@3/imx715_e@1a";
				};
			};
		};
	};
};
