#include "dt-bindings/clock/tegra234-clock.h"

#define RST_IO_EXP TEGRA234_MAIN_GPIO(AC,1)
#define PWM_CALIB_GPIO TEGRA234_MAIN_GPIO(H,7) //CAM0_PWDN
#define TRIGGER_SEL TEGRA234_MAIN_GPIO(I,0) //CAM0_RST
#define PWR_EN		TEGRA234_MAIN_GPIO(AC, 7)
#define CAM_LANES 4
#define CAM_LANES_STRING "4" 
#define SERDES_PIX_CLK_HZ "480000000" 
                                        
#define IMX390_MODE0 \
		mclk_khz = "24000"; \
		discontinuous_clk = "no"; \
		dpcm_enable = "false"; \
		cil_settletime = "0"; \
		dynamic_pixel_bit_depth = "12"; \
		csi_pixel_bit_depth = "12"; \
		mode_type = "bayer"; \
		pixel_phase = "rggb"; \
		active_w = "1920"; \
		active_h = "1080"; \
		readout_orientation = "0"; \
		line_length = "2200"; \
		inherent_gain = "1"; \
		pix_clk_hz = "74250000"; \
		serdes_pix_clk_hz = SERDES_PIX_CLK_HZ; \
		gain_factor = "10"; \
		min_gain_val = "0";  \
		max_gain_val = "300"; \
		step_gain_val = "3"; \
		default_gain = "0"; \
		min_hdr_ratio = "1"; \
		max_hdr_ratio = "1"; \
		framerate_factor = "1000000"; \
		min_framerate = "30000000"; \
		max_framerate = "30000000"; \
		step_framerate = "1"; \
		default_framerate = "30000000"; \
		exposure_factor = "1000000"; \
		min_exp_time = "118"; \
		max_exp_time = "33333"; \
		step_exp_time = "1"; \
		default_exp_time = "33333"; \
		embedded_metadata_height = "0"; \

/ {

    tegra-capture-vi {
        status = "okay";
        num-channels = <4>;
        ports {
		    #address-cells = <1>;
		    #size-cells = <0>;
		    status = "okay";
	        port@0 {
		    	reg = <0>;
	            status = "okay";
	            vi_in0: endpoint {
		    	    vc-id = <0>;
	                port-index = <2>;
	                status = "okay";
	                bus-width = <CAM_LANES>;
		    	    remote-endpoint = <&csi_out0>;
	            };
	        };
		    port@1 {
		    	status = "okay";
		    	reg = <1>;
		    	vi_in1: endpoint {
		    		vc-id = <1>;
		    		port-index = <2>;
		    		status = "okay";
		    		bus-width = <CAM_LANES>;
		    		remote-endpoint = <&csi_out1>;
		    	};
	        };
		    port@2 {
				status = "okay";
				reg = <2>;
				vi_in2: endpoint {
					vc-id = <0>;
					port-index = <0>;
					bus-width = <CAM_LANES>;
					remote-endpoint = <&csi_out2>;
					status = "okay";
				};
		    };
		    port@3{
		    	status = "okay";
		    	reg = <3>;
		    	vi_in3: endpoint {
		    		vc-id = <1>;
		    		port-index = <0>;
		    		bus-width = <CAM_LANES>;
		    		remote-endpoint = <&csi_out3>;
		    		status = "okay";
		    	};
		    };
	    };
    };

    host1x@13e00000 {
        nvcsi@15a00000 {
		    num-channels = <4>;
		    #address-cells = <1>;
		    #size-cells = <0>;
			status = "okay";
			channel@0 {
				status = "okay";
				reg = <0>;
				ports {
					#address-cells = <1>;
					#size-cells = <0>;
					port@0 {
					status = "okay";
					reg = <0>;
						csi_in0: endpoint@0 {
				 			status = "okay";
				 			port-index = <2>;
				 			vc-id = <0>;
				 			bus-width = <CAM_LANES>;
				 			remote-endpoint = <&cam_out0>;
			 			};
					};
					port@1 {
						status = "okay";
						reg = <1>;
	                    csi_out0: endpoint@1 {
	        	            status = "okay";
				    		port-index = <2>;
				    		vc-id = <0>;
				    		bus-width = <CAM_LANES>;
				    		remote-endpoint = <&vi_in0>;
	                    };
	                };
	            };
	        };
			channel@1 {
				status = "okay";
				reg = <1>;
				ports {
					#address-cells = <1>;
					#size-cells = <0>;
					port@0 {
						reg = <0>;
						status = "okay";
						csi_in1: endpoint@2 {
							status = "okay";
							port-index = <2>;
							vc-id = <1>;
							bus-width = <CAM_LANES>;
							remote-endpoint = <&cam_out1>;
						};
					};
					port@1 {
						status = "okay";
						reg = <1>;
	                    csi_out1: endpoint@3 {
	            	        status = "okay";
				    		port-index = <2>;
				    		vc-id = <1>;
				    		bus-width = <CAM_LANES>;
				    		remote-endpoint = <&vi_in1>;
	                    };
	                };
	            };
	        };
		    channel@2 {
	            status = "okay";
				reg = <2>;
	            ports {
			    #address-cells = <1>;
			    #size-cells = <0>;
	            	port@0 {
	                	status = "okay";
						reg = <0>;
	                	csi_in2: endpoint@4 {
	    	            	status = "okay";
	                    	port-index = <0>;
				    		bus-width = <CAM_LANES>;
							vc-id = <0>;
	                    	remote-endpoint = <&cam_out2>;
	                	};
	            	};
	            	port@1 {
	        	    	status = "okay";
						reg = <1>;
	                	csi_out2: endpoint@5 {
	            	        status = "okay";
				    		port-index = <0>;
				    		bus-width = <CAM_LANES>;
							vc-id = <0>;
				    		remote-endpoint = <&vi_in2>;
	                    };
	                };
	            };
	        };
	        channel@3 {
	            status = "okay";
		    	reg = <3>;
	            ports {
		        	#address-cells = <1>;
		        	#size-cells = <0>;
		        	port@0 {
		    			reg = <0>;
	                    status = "okay";
	                    csi_in3: endpoint@6 {
	        	            status = "okay";
		    			    port-index = <0>;
	                        bus-width = <CAM_LANES>;
		    				vc-id = <1>;
	                        remote-endpoint = <&cam_out3>;
	                    };
	                };
	                port@1 {
	                	status = "okay";
		    			reg = <1>;
	                    csi_out3: endpoint@7 {
	            	        status = "okay";
		    	    		port-index = <0>;
		    	    		bus-width = <CAM_LANES>;
		    				vc-id = <1>;
		    	    		remote-endpoint = <&vi_in3>;
	                    };
	                };
	            };
	        };
	    };
    };

	gpio@2200000 {
		camera-control-output-high {
			status = "okay";
			gpio-hog;
			gpios = <RST_IO_EXP 0>;
			output-high;
			label = "rst-io-expender"; 
		};
		camera-control-output-low {
			status = "okay";
			gpio-hog;
			gpios = <TRIGGER_SEL 0>;
			output-low;
			label = "trigger_sel";
		};
	};

	i2c@c250000 {
        tca9539_74:tca9539@74 {
            tca9539_74_outlow {
                status = "okay";
                gpio-hog;
                gpios = <0 0 1 0 2 0 3 0>;
                output-low;
                gpio-line-names = "RST_A","PWDN_A","RST_B","PWDN_B";
            };
            tca9539_74_input {
                status = "disabled";
            };
        };
    };

    i2c@3180000 {
		status = "okay";
		#address-cells = <1>;
		#size-cells = <0>;
        tca9564@70 {
	    	status = "okay";
	    	compatible = "nxp,pca9544";
	    	reg = <0x70>;
	    	#address-cells = <1>;
	    	#size-cells = <0>;
	    	vcc-supply = <&vdd_1v8_sys>;
	    	vcc-pullup-supply = <&battery_reg>;
			vcc_lp = "vcc";
			skip_mux_detect = "yes";
			force_bus_start = <0x1e>;
			i2c@0 {
				status = "okay";
				reg = <0>;
				i2c-mux,deselect-on-exit;
				#address-cells = <1>;
				#size-cells = <0>;

				dsera: li_max9296@48 {
					compatible = "li,li_max9296";
					reg = <0x48>;
					csi-mode = "2x4";
					max-src = <2>;
					status = "okay";
					reset-gpios = <&tca9539_74 0 GPIO_ACTIVE_HIGH>;
				};
				ser_prima: li_max9295_prim@62 {
					compatible = "li,li_max9295";
					reg = <0x62>;
					is-prim-ser;
					status = "okay";
				};
				ser_a0: li_max9295_a@40 {
					compatible = "li,li_max9295";
					reg = <0x40>;
					nvidia,gmsl-dser-device = <&dsera>;
					status = "okay";
				};
				
				ser_b0: li_max9295_b@60 {
					compatible = "li,li_max9295";
					reg = <0x60>;
					nvidia,gmsl-dser-device = <&dsera>;
					status = "okay";
				};

				imx390_a@1b {
					def-addr = <0x21>;
					clocks = <&bpmp_clks TEGRA234_CLK_EXTPERIPH1>, <&bpmp_clks TEGRA234_CLK_EXTPERIPH1>;
					clock-names = "extperiph1", "pllp_grtba";
					mclk = "extperiph1";
					nvidia,gmsl-ser-device = <&ser_a0>;
					nvidia,gmsl-dser-device = <&dsera>;
					compatible = "li,imx390";
					reg = <0x1b>;
					reg_mux = <0>;
		
					physical_w = "15.0";
					physical_h = "12.5";
					sensor_model = "imx390";
					post_crop_frame_drop = "0";
					use_decibel_gain = "true";
					use_sensor_mode_id = "true";
		
					status = "okay";
					
					mode0 {
						IMX390_MODE0
						tegra_sinterface = "serial_c";
						num_lanes = CAM_LANES_STRING;
						//mode_lanes = <4>;
						vc_id = "0";
						lane_polarity = "0";
					};
		
					ports {
						#address-cells = <1>;
						#size-cells = <0>;
						port@0{
							reg = <0>;
							cam_out0: endpoint {
								vc-id = <0>;
								port-index = <2>;
								bus-width = <CAM_LANES>;
								remote-endpoint = <&csi_in0>;
		
							};
						};
					};
					gmsl-link {
						src-csi-port = "b";
						dst-csi-port = "a";
						serdes-csi-link = "a";
						csi-mode = "1x4";
						st-vc = <0>;
						vc-id = <0>;
						num-lanes = <CAM_LANES>;
						streams = "ued-u1","raw12";
		
					};
				};
		
				imx390_b@1c {
					def-addr = <0x21>;
					clocks = <&bpmp_clks TEGRA234_CLK_EXTPERIPH1>, <&bpmp_clks TEGRA234_CLK_EXTPERIPH1>;
					clock-names = "extperiph1", "pllp_grtba";
					mclk = "extperiph1";
					compatible = "li,imx390";
					nvidia,gmsl-ser-device = <&ser_b0>;
					nvidia,gmsl-dser-device = <&dsera>;
					reg = <0x1c>;
					reg_mux = <0>;
		
					physical_w = "15.0";
					physical_h = "12.5";
					sensor_model = "imx390";
					post_crop_frame_drop = "0";
					use_decibel_gain = "true";
					use_sensor_mode_id = "true";
		
					status = "okay";
					mode0 {
						IMX390_MODE0
						tegra_sinterface = "serial_c";
						num_lanes = CAM_LANES_STRING;
						//mode_lanes = <4>;
						vc_id = "1";
						lane_polarity = "0";
					};
					ports {
						#address-cells = <1>;
						#size-cells = <0>;
						port@0{
							reg = <0>;
							cam_out1: endpoint {
								vc-id = <1>;
								port-index = <2>;
								bus-width = <CAM_LANES>;
								remote-endpoint = <&csi_in1>;
		
							};
						};
					};
					gmsl-link {
						src-csi-port = "b";
						dst-csi-port = "a";
						serdes-csi-link = "b";
						csi-mode = "1x4";
						st-vc = <0>;
						vc-id = <1>;
						num-lanes = <CAM_LANES>;
						streams = "ued-u1","raw12";
		
					};
				};
            };

		    i2c@1 {
				status = "okay";
				reg = <1>;
				i2c-mux,deselect-on-exit;
				#address-cells = <1>;
				#size-cells = <0>;
				dserb: li_max9296@48 {
					compatible = "li,li_max9296";
					reg = <0x48>;
					csi-mode = "2x4";
					max-src = <2>;
					status = "okay";
					reset-gpios = <&tca9539_74 2 GPIO_ACTIVE_HIGH>;
				};
				ser_primb: li_max9295_prim@62 {
					compatible = "li,li_max9295";
					reg = <0x62>;
					is-prim-ser;
					status = "okay";
				};
				ser_a1: li_max9295_a@40 {
					compatible = "li,li_max9295";
					reg = <0x40>;
					nvidia,gmsl-dser-device = <&dserb>;
					status = "okay";
				};
				
				ser_b1: li_max9295_b@60 {
					compatible = "li,li_max9295";
					reg = <0x60>;
					nvidia,gmsl-dser-device = <&dserb>;
					status = "okay";
				};
	
				imx390_c@1b {
					def-addr = <0x21>;
					clocks = <&bpmp_clks TEGRA234_CLK_EXTPERIPH1>, <&bpmp_clks TEGRA234_CLK_EXTPERIPH1>;
					clock-names = "extperiph1", "pllp_grtba";
					mclk = "extperiph1";
					nvidia,gmsl-ser-device = <&ser_a1>;
					nvidia,gmsl-dser-device = <&dserb>;
					compatible = "li,imx390";
					reg = <0x1b>;
					reg_mux = <1>;
	
					physical_w = "15.0";
					physical_h = "12.5";
					sensor_model = "imx390";
					post_crop_frame_drop = "0";
					use_decibel_gain = "true";
					use_sensor_mode_id = "true";
	
					status = "okay";
					
					mode0 {
						IMX390_MODE0
						tegra_sinterface = "serial_a";
						num_lanes = CAM_LANES_STRING;
						//mode_lanes = <4>;
						vc_id = "0";
						lane_polarity = "6";
					};
	
					ports {
						#address-cells = <1>;
						#size-cells = <0>;
						port@0{
							reg = <0>;
							cam_out2: endpoint {
								vc-id = <0>;
								port-index = <0>;
								bus-width = <CAM_LANES>;
								remote-endpoint = <&csi_in2>;
	
							};
						};
					};
					gmsl-link {
						src-csi-port = "b";
						dst-csi-port = "a";
						serdes-csi-link = "a";
						csi-mode = "1x4";
						st-vc = <0>;
						vc-id = <0>;
						num-lanes = <CAM_LANES>;
						streams = "ued-u1","raw12";
	
					};
				};
	
				imx390_d@1c {
					def-addr = <0x21>;
					clocks = <&bpmp_clks TEGRA234_CLK_EXTPERIPH1>, <&bpmp_clks TEGRA234_CLK_EXTPERIPH1>;
					clock-names = "extperiph1", "pllp_grtba";
					mclk = "extperiph1";
					compatible = "li,imx390";
					nvidia,gmsl-ser-device = <&ser_b1>;
					nvidia,gmsl-dser-device = <&dserb>;
					reg = <0x1c>;
					reg_mux = <1>;
	
					physical_w = "15.0";
					physical_h = "12.5";
					sensor_model = "imx390";
					post_crop_frame_drop = "0";
					use_decibel_gain = "true";
					use_sensor_mode_id = "true";
	
					status = "okay";
					mode0 {
						IMX390_MODE0
						tegra_sinterface = "serial_a";
						num_lanes = CAM_LANES_STRING;
						//mode_lanes = <4>;
						vc_id = "1";
						lane_polarity = "6";
					};
					ports {
						#address-cells = <1>;
						#size-cells = <0>;
						port@0{
							reg = <0>;
							cam_out3: endpoint {
								vc-id = <1>;
								port-index = <0>;
								bus-width = <CAM_LANES>;
								remote-endpoint = <&csi_in3>;
	
							};
						};
					};
					gmsl-link {
						src-csi-port = "b";
						dst-csi-port = "a";
						serdes-csi-link = "b";
						csi-mode = "1x4";
						st-vc = <0>;
						vc-id = <1>;
						num-lanes = <CAM_LANES>;
						streams = "ued-u1","raw12";
	
					};
				};
		    };
        };
    };

    tegra-camera-platform {
        num_csi_lanes = <8>;
        max_lane_speed = <4000000>;
        min_bits_per_pixel = <10>;
        vi_peak_byte_per_pixel = <2>;
        vi_bw_margin_pct = <25>;
		//max_pixel_rate = <750000>;
        isp_peak_byte_per_pixel = <5>;
        isp_bw_margin_pct = <25>;
		compatible = "nvidia, tegra-camera-platform";
		status = "okay";
        
		modules {
			status = "okay";
			module0 {
				status = "okay";
				badge = "imx390_bottomleft";
				position = "bottomleft";
				orientation = "1";
				drivernode0 {
					status = "okay";
					pcl_id = "v4l2_sensor";
					devname = "imx390 30-001b";
					proc-device-tree = "/proc/device-tree/i2c@3180000/tca9564@70/i2c@0/imx390_a@1b";
				};
				
			};
			module1 {
				status = "okay";
				badge = "imx390_bottomright";
				position = "bottomright";
				orientation = "1";
				drivernode0 {
					status = "okay";
					pcl_id = "v4l2_sensor";
					devname = "imx390 30-001c";
					proc-device-tree = "/proc/device-tree/i2c@3180000/tca9564@70/i2c@0/imx390_b@1c";
				};
			};
			module2 {
				status = "okay";
				badge = "imx390_topleft";
				position = "topleft";
				orientation = "1";
				drivernode0 {
					status = "okay";
					pcl_id = "v4l2_sensor";
					devname = "imx390 31-001b";
					proc-device-tree = "/proc/device-tree/i2c@3180000/tca9564@70/i2c@1/imx390_c@1b";
				};
			};
			module3 {
				status = "okay";
				badge = "imx390_topright";
				position = "topright";
				orientation = "1";
				drivernode0 {
					status = "okay";
					pcl_id = "v4l2_sensor";
					devname = "imx390 31-001c";
					proc-device-tree = "/proc/device-tree/i2c@3180000/tca9564@70/i2c@1/imx390_d@1c";
				};
			};
        };
    };
};
