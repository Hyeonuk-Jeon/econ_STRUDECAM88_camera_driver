//#include "tegra234-orin-agx-cti-csi.dtsi"
#include "dt-bindings/clock/tegra234-clock.h"

// #define RST_IO_EXP 			TEGRA234_MAIN_GPIO(AC,1)
// #define PWM_CALIB_GPIO 		TEGRA234_MAIN_GPIO(H,7) //CAM0_PWDN
// #define TRIGGER_SEL 		TEGRA234_MAIN_GPIO(I,0) //CAM0_RST
// #define PWR_EN				TEGRA234_MAIN_GPIO(AC, 7)

#define CAM0_PWDN	TEGRA234_MAIN_GPIO(H, 6)
// trig 	- 	GPIO3 PR.00 	- 	MFP7
// reset 	- 	GPIO3 PQ.05 	- 	MFP8
// boot 	- 	GPIO3 PCC.03 	- 	MFP9
// int 		- 	GPIO3 PCC.01 	- 	MFP10
#define DESER_RESET TEGRA234_MAIN_GPIO(Q, 5)
#define DESER_TRIG  TEGRA234_MAIN_GPIO(R, 0)
#define DESER_BOOT  TEGRA234_AON_GPIO(CC, 3)
#define DESER_INT   TEGRA234_AON_GPIO(CC, 1)

#define CAM_LANES 	4
#define CAM_LANES_STRING "4"
#define MODE_VC "0"
#define SERDES_PIX_CLK_HZ "480000000" 
//"590000000"

                                        
#define IMX390_MODE0 \
		mclk_khz = "24000"; \
		discontinuous_clk = "no"; \
		dpcm_enable = "false"; \
		cil_settletime = "0"; \
		dynamic_pixel_bit_depth = "12"; \
		csi_pixel_bit_depth = "12"; \
		mode_type = "bayer"; \
		pixel_phase = "rggb"; \
		active_w = "1920"; \
		active_h = "1080"; \
		readout_orientation = "0"; \
		line_length = "2200"; \
		inherent_gain = "1"; \
		pix_clk_hz = "74250000"; \
		serdes_pix_clk_hz = SERDES_PIX_CLK_HZ; \
		gain_factor = "10"; \
		min_gain_val = "0";  \
		max_gain_val = "300"; \
		step_gain_val = "3"; \
		default_gain = "0"; \
		min_hdr_ratio = "1"; \
		max_hdr_ratio = "1"; \
		framerate_factor = "1000000"; \
		min_framerate = "30000000"; \
		max_framerate = "30000000"; \
		step_framerate = "1"; \
		default_framerate = "30000000"; \
		exposure_factor = "1000000"; \
		min_exp_time = "118"; \
		max_exp_time = "33333"; \
		step_exp_time = "1"; \
		default_exp_time = "33333"; \
		embedded_metadata_height = "0"; \


//serdes_pix_clk_hz = "299000000"; //orig val

/ {

	gpio@2200000 {
		status = "okay";
		camera-control-output-low {
			gpio-hog;
			output-low;
			gpios = <CAM0_PWDN 0 DESER_RESET 0>;
			label = "cam0-pwdn", "deser-reset";
			status = "okay";
		};
	};

	gpio@c2f0000 {
		status = "okay";
		camera-control-output-low-aon {
			gpio-hog;
			output-low;
			gpios = <DESER_BOOT 0>;
			label = "deser-boot";
			status = "okay";
		};
	};

    i2c@3180000 {
		status = "okay";
		#address-cells = <1>;
		#size-cells = <0>;

		dsera: li_max9296@48 {
			compatible = "li,li_max9296";
			reg = <0x48>;
			csi-mode = "2x4";
			max-src = <2>;
			status = "okay";
			reset-gpios = <&tegra_main_gpio DESER_RESET GPIO_ACTIVE_HIGH>;
		};
		ser_prima: li_max9295_prim@62 {
			compatible = "li,li_max9295";
			reg = <0x62>;
			is-prim-ser;
			status = "okay";
		};
		ser_a0: li_max9295_a@40 {
			compatible = "li,li_max9295";
			reg = <0x40>;
			nvidia,gmsl-dser-device = <&dsera>;
			status = "okay";
		};
		ser_b0: li_max9295_b@60 {
			compatible = "li,li_max9295";
			reg = <0x60>;
			nvidia,gmsl-dser-device = <&dsera>;
			status = "okay";
		};
		imx390_a@1b {
			def-addr = <0x21>;
			clocks = <&bpmp_clks TEGRA234_CLK_EXTPERIPH1>, <&bpmp_clks TEGRA234_CLK_EXTPERIPH1>;
			clock-names = "extperiph1", "pllp_grtba";
			mclk = "extperiph1";
			nvidia,gmsl-ser-device = <&ser_a0>;
			nvidia,gmsl-dser-device = <&dsera>;
			compatible = "li,imx390";
			reg = <0x1b>;
			reg_mux = <0>;

			physical_w = "15.0";
			physical_h = "12.5";
			sensor_model = "imx390";
			post_crop_frame_drop = "0";
			use_decibel_gain = "true";
			use_sensor_mode_id = "true";

			status = "okay";
			
			mode0 {
				IMX390_MODE0
				lane_polarity = "6";
				tegra_sinterface = "serial_a";
				num_lanes = "4";
				//mode_lanes = <4>;
				vc_id = "0";
			};

			ports {
				#address-cells = <1>;
				#size-cells = <0>;
				port@0{
					reg = <0>;
					cam_out0: endpoint {
						vc-id = <0>;
						port-index = <0>;
						bus-width = <CAM_LANES>;
						remote-endpoint = <&csi_in0>;

					};
				};
			};
			gmsl-link {
				src-csi-port = "b";
				dst-csi-port = "a";
				serdes-csi-link = "a";
				csi-mode = "1x4";
				st-vc = <0>;
				vc-id = <0>;
				num-lanes = <CAM_LANES>;
				streams = "ued-u1","raw12";

			};
		};
		imx390_b@1c {
			def-addr = <0x21>;
			clocks = <&bpmp_clks TEGRA234_CLK_EXTPERIPH1>, <&bpmp_clks TEGRA234_CLK_EXTPERIPH1>;
			clock-names = "extperiph1", "pllp_grtba";
			mclk = "extperiph1";
			compatible = "li,imx390";
			nvidia,gmsl-ser-device = <&ser_b0>;
			nvidia,gmsl-dser-device = <&dsera>;
			reg = <0x1c>;
			reg_mux = <0>;

			physical_w = "15.0";
			physical_h = "12.5";
			sensor_model = "imx390";
			post_crop_frame_drop = "0";
			use_decibel_gain = "true";
			use_sensor_mode_id = "true";

			status = "okay";
			mode0 {
				IMX390_MODE0
				lane_polarity = "0";
				tegra_sinterface = "serial_c";
				num_lanes = "4";
				//mode_lanes = <4>;
				vc_id = "1";
			};
			ports {
				#address-cells = <1>;
				#size-cells = <0>;
				port@0{
					reg = <0>;
					cam_out1: endpoint {
						vc-id = <0>;
						port-index = <2>;
						bus-width = <CAM_LANES>;
						remote-endpoint = <&csi_in1>;

					};
				};
			};
			gmsl-link {
				src-csi-port = "b";
				dst-csi-port = "b";
				serdes-csi-link = "b";
				csi-mode = "1x4";
				st-vc = <0>;
				vc-id = <1>;
				num-lanes = <CAM_LANES>;
				streams = "ued-u1","raw12";
			};
		};
    };
    
    tegra-capture-vi {
        status = "okay";
        num-channels = <2>;
        ports {
	    	#address-cells = <1>;
	    	#size-cells = <0>;
	    	status = "okay";
            port@0 {
			reg = <0>;
                status = "okay";
                vi_in0: endpoint {
		    		vc-id = <0>;
                    port-index = <0>;
                    status = "okay";
                    bus-width = <CAM_LANES>;
		    		remote-endpoint = <&csi_out0>;
                };
            };
            port@1 {
                status = "okay";
				reg = <1>;
                vi_in1: endpoint {
		    		vc-id = <1>;
                    port-index = <2>;
                    status = "okay";
                    bus-width = <CAM_LANES>;
		    		remote-endpoint = <&csi_out1>;
                };
            };
        };
    };

    host1x@13e00000 {
        nvcsi@15a00000 {
	    	num-channels = <2>;
	    	#address-cells = <1>;
	    	#size-cells = <0>;
            status = "okay";
            channel@0 {
                status = "okay";
				reg = <0>;
                ports {
		    		#address-cells = <1>;
		    		#size-cells = <0>;
                    port@0 {
                        status = "okay";
						reg = <0>;
                        csi_in0: endpoint@0 {
                            status = "okay";
                            port-index = <0>;
			    			vc-id = <0>;
			    			bus-width = <CAM_LANES>;
                            remote-endpoint = <&cam_out0>;
                        };
                    };
                    port@1 {
                        status = "okay";
						reg = <1>;
                        csi_out0: endpoint@1 {
                            status = "okay";
			    			port-index = <0>;
			    			vc-id = <0>;
			    			bus-width = <CAM_LANES>;
			    			remote-endpoint = <&vi_in0>;
                        };
                    };
                };
            };
            channel@1 {
                status = "okay";
				reg = <1>;
                ports {
		    		#address-cells = <1>;
		    		#size-cells = <0>;
                    
		    		port@0 {
						reg = <0>;
                		status = "okay";
                		csi_in1: endpoint@2 {
                            status = "okay";
			    			port-index = <2>;
			    			vc-id = <0>;
                            bus-width = <CAM_LANES>;
                            remote-endpoint = <&cam_out1>;
                        };
                    };
                    port@1 {
                        status = "okay";
						reg = <1>;
                        csi_out1: endpoint@3 {
                            status = "okay";
			    			port-index = <2>;
			    			vc-id = <1>;
			    			bus-width = <CAM_LANES>;
			    			remote-endpoint = <&vi_in1>;
                        };
                    };
                };
            };
        };
    };


    tegra-camera-platform {
        num_csi_lanes = <8>;
        max_lane_speed = <1500000>;
        min_bits_per_pixel = <10>;
        vi_peak_byte_per_pixel = <2>;
        vi_bw_margin_pct = <25>;
		max_pixel_rate = <240000>;
        isp_peak_byte_per_pixel = <5>;
        isp_bw_margin_pct = <25>;
		compatible = "nvidia, tegra-camera-platform";
		status = "okay";
        
		modules {
			status = "okay";
			module0 {
				status = "okay";
				badge = "imx390_bottomleft";
				position = "bottomleft";
				orientation = "1";
				drivernode0 {
					status = "okay";
					pcl_id = "v4l2_sensor";
					devname = "imx390 2-001b";
					proc-device-tree = "/proc/device-tree/i2c@3180000/imx390_a@1b";
				};
			};
			module1 {
				status = "okay";
				badge = "imx390_bottomright";
				position = "bottomright";
				orientation = "1";
				drivernode0 {
					status = "okay";
					pcl_id = "v4l2_sensor";
					devname = "imx390 2-001c";
					proc-device-tree = "/proc/device-tree/i2c@3180000/imx390_b@1c";
				};
			};		
        };
    };
};
