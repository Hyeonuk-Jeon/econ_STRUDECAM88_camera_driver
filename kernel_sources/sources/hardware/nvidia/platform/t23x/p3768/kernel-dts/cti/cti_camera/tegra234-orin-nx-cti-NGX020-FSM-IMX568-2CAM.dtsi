#include "tegra234-orin-nx-cti-NGX020-FSM-2CAM-base.dtsi"
#include "tegra234-cti-fsm-imx568-modes-header.dtsi"

#include "dt-bindings/clock/tegra234-clock.h"


#define NUM_LANES "4"
#define PIX_CLK_HZ "475200000"
#define BUS_WIDTH <4>
/ {
	i2c@3180000 {
		tca9548@70 {
			status = "okay";	
			i2c@0 {
					status = "okay";
					imx568_a@1a{
								status  = "okay";							
								devnode = "video0";
								
                                reset-gpios = <&gpio_i2c_cam CAM0_RST_0 GPIO_ACTIVE_HIGH>;
								pwdn-gpios = <&tegra_main_gpio CAM0_PWDN GPIO_ACTIVE_HIGH>;
                                
                                SENSOR_COMMON


#define TEGRA_SINTERFACE I2C0_SINTERFACE
#define LANE_POLARITY I2C0_LANEPOLARITY

                                SENSOR_MODE0_4LANE
                                SENSOR_MODE1_4LANE
                                SENSOR_MODE2_4LANE
                                SENSOR_MODE3_4LANE
                                SENSOR_MODE4_4LANE
                                SENSOR_MODE5_4LANE
                                SENSOR_MODE6_4LANE
                                SENSOR_MODE7_4LANE

								


								ports {
									#address-cells = <1>;
									#size-cells = <0>;

									port@0 {
										reg = <0>;
										vi_out0: endpoint {
											port-index = VI_CSI_PORT_INDEX0;
											bus-width = BUS_WIDTH;
											remote-endpoint = <&csi_in0>;
										};
									};
								};
					};
				};
				i2c@1 {
					status = "okay";
					imx568_c@1a{
								status = "okay";
								devnode = "video2";
								
                                reset-gpios = <&gpio_i2c_cam CAM1_RST_0 GPIO_ACTIVE_HIGH>;
								pwdn-gpios = <&tegra_main_gpio CAM1_PWDN GPIO_ACTIVE_HIGH>;
								
                                SENSOR_COMMON

#undef TEGRA_SINTERFACE
#undef LANE_POLARITY
#define TEGRA_SINTERFACE I2C1_SINTERFACE
#define LANE_POLARITY I2C1_LANEPOLARITY

                                SENSOR_MODE0_4LANE
                                SENSOR_MODE1_4LANE
                                SENSOR_MODE2_4LANE
                                SENSOR_MODE3_4LANE
                                SENSOR_MODE4_4LANE
                                SENSOR_MODE5_4LANE
                                SENSOR_MODE6_4LANE
                                SENSOR_MODE7_4LANE



								ports {
									#address-cells = <1>;
									#size-cells = <0>;

									port@0 {
										reg = <0>;
										vi_out1: endpoint {
											port-index = VI_CSI_PORT_INDEX1;
											bus-width = BUS_WIDTH;
											remote-endpoint = <&csi_in1>;
										};
									};
								};
							};
						};
				};
				
			};

	tegra-camera-platform {
		modules {
			module0 {
				badge = "imx568_bottomleft_framos";
				position = "bottomleft";
				orientation = "1";
				status = "okay";
				drivernode0 {
					status = "okay";
					pcl_id = "v4l2_sensor";
					devname = "imx568 30-001a";
					proc-device-tree = "/proc/device-tree/i2c@3180000/tca9548@70/i2c@0/imx568_a@1a";
				};
			};
			module1 {
				badge = "imx568_centerright_framos";
				position = "centerright";
				orientation = "1";
				status = "okay";
				drivernode0 {
					status = "okay";
					pcl_id = "v4l2_sensor";
					devname = "imx568 31-001a";
					proc-device-tree = "/proc/device-tree/i2c@3180000/tca9548@70/i2c@1/imx568_c@1a";
				};
			};
		};
	};
};
