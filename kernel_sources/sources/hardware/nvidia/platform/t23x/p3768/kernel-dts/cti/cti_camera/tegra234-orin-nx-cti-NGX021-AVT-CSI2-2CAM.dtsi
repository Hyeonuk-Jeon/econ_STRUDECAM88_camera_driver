#include "dt-bindings/gpio/tegra234-gpio.h"

#define CAMERA_I2C_MUX_BUS(x) (0x1E + x)

#define MIPI_SW_SEL_1	TEGRA234_AON_GPIO(CC,1)
#define MIPI_SW_SEL_2	TEGRA234_MAIN_GPIO(Q,5)

#define CAM0_PWR_EN_0	TEGRA234_MAIN_GPIO(H,6)
#define CAM1_PWR_EN_0	TEGRA234_MAIN_GPIO(AC,0)
#define CAM2_PWR_EN_0 	TEGRA234_AON_GPIO(CC,2)
#define CAM3_PWR_EN_0	TEGRA234_AON_GPIO(CC,3)

//tegra sinteface and lane polarity
#define I2C0_SINTERFACE "serial_a"
#define I2C1_SINTERFACE "serial_b"
#define I2C2_SINTERFACE "serial_c"
#define I2C3_SINTERFACE "serial_d"

#define MODE0_I2C0_LANES "4"
#define MODE0_I2C1_LANES "2"
#define MODE0_I2C2_LANES "4"
#define MODE0_I2C3_LANES "2"

#define I2C0_LANEPOLARITY "6"
#define I2C1_LANEPOLARITY "6"
#define I2C2_LANEPOLARITY "0"
#define I2C3_LANEPOLARITY "0"

#define VI_CSI_PORT_INDEX0 <0>
#define VI_CSI_PORT_INDEX1 <1>
#define VI_CSI_PORT_INDEX2 <2>
#define VI_CSI_PORT_INDEX3 <3>

//This will serve as the default bus_width...
#define BUS_WIDTH_INDEX0 <4>
#define BUS_WIDTH_INDEX1 <2>
#define BUS_WIDTH_INDEX2 <4>
#define BUS_WIDTH_INDEX3 <2>

#define PIX_CLK_HZ "750000000"
//#define PIX_CLK_HZ "375000000"


#define AVT_MODE_0 \
	discontinuous_clk = "no";  \
    cil_settletime = "0"; \
    embedded_metadata_height = "0"; \
    mclk_khz = "24000"; \
    phy_mode = "DPHY"; \
    dpcm_enable = "false"; \
   	csi_pixel_bit_depth = "4"; \
   	active_w = "5488"; \
   	active_h = "4112"; \
   	pixel_t = "bayer_bggr"; \
    readout_orientation = "0"; \
    line_length = "5488"; \
    inherent_gain = "1"; \
    mclk_multiplier = "31.25"; \
    pix_clk_hz = PIX_CLK_HZ; \
    gain_factor = "16"; \
   	framerate_factor = "1000000"; \
    exposure_factor = "1000000"; \
   	min_gain_val = "16"; \
    max_gain_val = "256"; \
    step_gain_val = "1"; \
    min_hdr_ratio = "1"; \
    max_hdr_ratio = "64"; \
   	min_framerate = "1500000"; \
    max_framerate = "30000000"; \
    step_framerate = "1"; \
    min_exp_time = "34"; \
    max_exp_time = "550385"; \
    step_exp_time = "1";

#define AVT_NODE_COMMON \
	status = "okay"; \
	clocks = <&bpmp_clks TEGRA234_CLK_EXTPERIPH1>, \
             <&bpmp_clks TEGRA234_CLK_PLLP_OUT0>; \
	clock-names = "extperiph1", "pllp_grtba"; \
	mclk = "extperiph1"; \
	compatible = "alliedvision,avt_csi2"; \
	csi_lanes = <4>; 

/ {
	//MAIN
	gpio@2200000 {
		status = "okay";
		camera-control-low {
			gpio-hog;
			output-low;
			gpios = <MIPI_SW_SEL_2 0>; //force x4 lanes
			label = "mipi_sw_sel_1";
			status = "okay";
		};
		camera-control-high {
			gpio-hog;
			output-high;
			gpios = <CAM0_PWR_EN_0 0 CAM1_PWR_EN_0 0>; //these are implemented in the main gpio controller
			label = "cam0_pwr_en","cam1_pwr_en";
			status = "okay";
		};
	};

	//AON
	gpio@c2f0000 {
		status = "okay";
		camera-control-low-aon {
			gpio-hog;
			output-low;
			gpios = <MIPI_SW_SEL_1 0>;
			label = "mipi_sw_sel_0";
			status = "okay";
		};
		camera-control-high-aon {
			gpio-hog;
			output-high;
			gpios = <CAM2_PWR_EN_0 0 CAM3_PWR_EN_0 0>;
			label = "cam2_pwr_en","cam3_pwr_en";
			status = "okay";
		};
	};

	i2c@3180000 {

		tca9548@70 {
			compatible = "nxp,pca9548";
			reg = <0x70>;
			#address-cells = <1>;
			#size-cells = <0>;
			skip_mux_detect = "yes";
			vcc-supply = <&vdd_3v3_sys>;
			force_bus_start = <CAMERA_I2C_MUX_BUS(0)>;
			status = "okay";
			
			i2c@0 {
				reg = <0>;
				i2c-mux,deselect-on-exit;
				#address-cells = <1>;
				#size-cells = <0>;
				status = "okay";

				avt_csi2_a@3c {
					AVT_NODE_COMMON
					devnode = "video0";
					reg = <0x3c>;

					mode0 {
						tegra_sinterface = I2C0_SINTERFACE;
						num_lanes = MODE0_I2C0_LANES;
						lane_polarity = I2C0_LANEPOLARITY;
						vc_id = "0";
						AVT_MODE_0
					};
					ports {
						#address-cells = <1>;
						#size-cells = <0>;
						port@0 {
							reg = <0>;
							cam_out0: endpoint {
								vc-id = <0>;
								port-index = VI_CSI_PORT_INDEX0;
								bus-width = BUS_WIDTH_INDEX0;
								remote-endpoint = <&csi_in0>;
							};
						};
					};
				};
			};
			i2c@1 {
				reg = <1>;
				i2c-mux,deselect-on-exit;
				#address-cells = <1>;
				#size-cells = <0>;
				status = "disabled";
				
			};	
			i2c@2 {
				reg = <2>;
				i2c-mux,deselect-on-exit;
				#address-cells = <1>;
				#size-cells = <0>;
				status = "okay";
				avt_csi2_c@3c {
					AVT_NODE_COMMON
					devnode = "video2";
					reg = <0x3c>;

					mode0 {
						tegra_sinterface = I2C2_SINTERFACE;
						num_lanes = MODE0_I2C2_LANES;
						lane_polarity = I2C2_LANEPOLARITY;
						AVT_MODE_0
						vc_id = "0";
					};
					ports {
						#address-cells = <1>;
						#size-cells = <0>;
						port@0 {
							reg = <0>;
							cam_out1: endpoint {
								vc-id = <0>;
								port-index = VI_CSI_PORT_INDEX2;
								bus-width = BUS_WIDTH_INDEX2;
								remote-endpoint = <&csi_in1>;	
							};
						};
					};
				};
			};
			i2c@3 {
				reg = <3>;
				i2c-mux,deselect-on-exit;
				#address-cells = <1>;
				#size-cells = <0>;
				status = "disabled";
				
			};
		};
	};

	tegra-capture-vi {
		num-channels = <2>;
		status = "okay";
		ports {
			#address-cells = <1>;
			#size-cells = <0>;
			port@0 {
				status = "okay";
				reg = <0>;
				vi_in0: endpoint {
					status = "okay";
					vc-id = <0>;
					port-index = VI_CSI_PORT_INDEX0;
					bus-width = BUS_WIDTH_INDEX0;
					remote-endpoint = <&csi_out0>;
				};
			};
			port@1 {
				status = "okay";
				reg = <1>;
				vi_in1: endpoint {
					status = "okay";
					vc-id = <0>;
					port-index = VI_CSI_PORT_INDEX2;
					bus-width = BUS_WIDTH_INDEX2;
					remote-endpoint = <&csi_out1>;
				};
			};
		};
	};

	host1x@13e00000 {
		nvcsi@15a00000 {
			num-channels = <2>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "okay";
			channel@0 {
				status = "okay";
				reg = <0>;
				ports {
					#address-cells = <1>;
					#size-cells = <0>;
					status = "okay";
					port@0 {
						status = "okay";
						reg = <0>;
						csi_in0: endpoint@0 {
							status = "okay";
							port-index = VI_CSI_PORT_INDEX0;
							bus-width = BUS_WIDTH_INDEX0;
							remote-endpoint = <&cam_out0>;
						};
					};
					port@1 {
						status = "okay";
						reg = <1>;
						csi_out0: endpoint@1 {
							status = "okay";
							remote-endpoint = <&vi_in0>;
						};
					};
				};
			};
			channel@1 {
				status = "okay";
				reg = <1>;
				ports {
					#address-cells = <1>;
					#size-cells = <0>;
					status = "okay";
					port@0 {
						status = "okay";
						reg = <0>;
						csi_in1: endpoint@2 {
							status = "okay";
							port-index = VI_CSI_PORT_INDEX2;
							bus-width = BUS_WIDTH_INDEX2;
							remote-endpoint = <&cam_out1>;
						};
					};
					port@1 {
						status = "okay";
						reg = <1>;
						csi_out1: endpoint@3 {
							remote-endpoint = <&vi_in1>;
						};
					};
				};
			};
		};
	};
	
	tegra-camera-platform {
		compatible = "nvidia, tegra-camera-platform";
		num_csi_lanes = <8>;
		max_lane_speed = <1500000>;
		min_bits_per_pixel = <10>;
		vi_peak_byte_per_pixel = <2>;
		vi_bw_margin_pct = <25>;
		max_pixel_rate = <240000>;
		isp_peak_byte_per_pixel = <5>;
		isp_bw_margin_pct = <25>;
	};

};

