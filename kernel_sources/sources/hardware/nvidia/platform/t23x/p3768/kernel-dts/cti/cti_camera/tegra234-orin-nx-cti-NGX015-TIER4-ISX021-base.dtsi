#include "dt-bindings/clock/tegra234-clock.h"
#include "tegra234-cti-tier4-isx021-modes-header.dtsi"

#define CAM_LANES 4
#define NUM_LANES "4"
#define BUS_WIDTH 4

#define VC_ID0 "0"
#define VC_ID1 "1"
#define VC_ID0_PORTS 0 
#define VC_ID1_PORTS 1


&cti_polaris_coaxA{
    regulator-always-on;
};
&cti_polaris_coaxB{
    regulator-always-on;
};
&cti_polaris_coaxC{
    regulator-always-on;
};
&cti_polaris_coaxD{
    regulator-always-on;
};

/ {

    tegra-capture-vi {
        status = "okay";
        num-channels = <4>;
        ports {
	    #address-cells = <1>;
	    #size-cells = <0>;
	    status = "okay";
            port@0 {
		reg = <0>;
                status = "okay";
                vi_in0: endpoint {
		            vc-id = <VC_ID0_PORTS>;
                    port-index = <0>;
                    status = "okay";
                    bus-width = <4>;
		    remote-endpoint = <&csi_out0>;
                };
            };
            port@1 {
                status = "okay";
                reg = <1>;
                vi_in1: endpoint {
                    vc-id = <VC_ID1_PORTS>;
                    port-index = <0>;
                    status = "okay";
                    bus-width = <4>;
                    remote-endpoint = <&csi_out1>;
                };
            };
            port@2 {
                status = "okay";
                reg = <2>;
                vi_in2: endpoint {
                    vc-id = <VC_ID0_PORTS>;
                    port-index = <2>;
                    status = "okay";
                    bus-width = <4>;
                    remote-endpoint = <&csi_out2>;
                };
                
            };
            port@3 {
                status = "okay";
                reg = <3>;
                vi_in3: endpoint {
                    vc-id = <VC_ID1_PORTS>;
                    port-index = <2>;
                    status = "okay";
                    bus-width = <4>;
                    remote-endpoint = <&csi_out3>;
                };

            };


    };
    };

    host1x@13e00000 {
        nvcsi@15a00000 {
	    num-channels = <4>;
	    #address-cells = <1>;
	    #size-cells = <0>;
            status = "okay";
            channel@0 {
                status = "okay";
		        reg = <0>;
                ports {
		            #address-cells = <1>;
		            #size-cells = <0>;
                    port@0 {
                        status = "okay";
		            	reg = <0>;
                        csi_in0: endpoint@0 {
                            status = "okay";
                            port-index = <0>;
			                bus-width = <4>;
                            remote-endpoint = <&cam_out0>;
                        };
                    };
                    port@1 {
                        status = "okay";
		            	reg = <1>;
                        csi_out0: endpoint@1 {
                            status = "okay";
			                port-index = <0>;
			                bus-width = <4>;
			                remote-endpoint = <&vi_in0>;
                        };
                    };
                };
            };
            channel@1 {
                status = "okay";
            reg = <1>;
            ports {
                #address-cells = <1>;
                #size-cells = <0>;

                port@0 {
                            reg = <0>;
                            status = "okay";
                            csi_in1: endpoint@2 {
                                status = "okay";
                                port-index = <0>;
                                bus-width = <4>;
                                remote-endpoint = <&cam_out1>;
                            };
                        };
                        port@1 {
                            status = "okay";
                              reg = <1>;
                            csi_out1: endpoint@3 {
                                status = "okay";
                    port-index = <0>;
                    bus-width = <4>;
                    remote-endpoint = <&vi_in1>;
                            };
                        };
                    };
                };
            channel@2 {
                status = "okay";
            reg = <2>;
            ports {
                #address-cells = <1>;
                #size-cells = <0>;

                port@0 {
                            reg = <0>;
                            status = "okay";
                            csi_in2: endpoint@4 {
                                status = "okay";
                                port-index = <2>;
                                bus-width = <4>;
                                remote-endpoint = <&cam_out2>;
                            };
                        };
                        port@1 {
                            status = "okay";
                              reg = <1>;
                            csi_out2: endpoint@5 {
                                status = "okay";
                    port-index = <2>;
                    bus-width = <4>;
                    remote-endpoint = <&vi_in2>;
                            };
                        };
                    };
                };
            channel@3{
                status = "okay";
            reg = <3>;
            ports {
                #address-cells = <1>;
                #size-cells = <0>;

                port@0 {
                            reg = <0>;
                            status = "okay";
                            csi_in3: endpoint@6 {
                                status = "okay";
                                port-index = <2>;
                                bus-width = <4>;
                                remote-endpoint = <&cam_out3>;
                            };
                        };
                        port@1 {
                            status = "okay";
                              reg = <1>;
                            csi_out3: endpoint@7 {
                                status = "okay";
                    port-index = <2>;
                    bus-width = <4>;
                    remote-endpoint = <&vi_in3>;
                            };
                        };
                    };
                };

            };
    };
    i2c@c250000 {

        tca9539_74:tca9539@74 {
            gpio-line-names = "RST_A","PWDN_A","RST_B","PWDN_B","TEMP_SNS_PEN","CAM_PRST#_A","CAM_PRST#_B","CAM_PRST#_C", 
            "CAM_PRST#_D", "CFG_CTRL_Nch", "CFG_CTRL_Pch","DES_STATE_RSTA", "DES_STATE_RSTB";
            tca9539_74_outlow {
                status = "okay";
                gpio-hog;
                gpios = <0 0 1 0 2 0 3 0 4 0 9 0 10 0>;
                output-low;
                line-name = "RST_A","PWDN_A","RST_B","PWDN_B","TEMP_SNS_PEN", "CFG_CTRL_Nch", "CFG_CTRL_Pch";
            };
            tca9539_74_outhigh {
                status = "okay";
                gpio-hog;
                gpios = < 5 0 6 0 7 0 8 0 11 0 12 0>;
                output-high;
                line-name = "CAM_PRST#_A","CAM_PRST#_B","CAM_PRST#_C", "CAM_PRST#_D","DES_STATE_RSTA", "DES_STATE_RSTB";
            };
            tca9539_74_input {
                status = "disabled";
            };

        };
    };



    i2c@3180000 {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;
        tca9564@70 {
	    status = "okay";
	    compatible = "nxp,pca9544";
	    reg = <0x70>;
	    #address-cells = <1>;
	    #size-cells = <0>;
	    vcc-supply = <&vdd_1v8_sys>;
	    //skip_mux_detect;
	    force_bus_start = <0x28>;
       i2c@0 {
        status = "okay";
		reg = <0>;
		i2c-mux,deselect-on-exit;
		#address-cells = <1>;
		#size-cells = <0>;

        dsera: max9296@48 {
           compatible = "nvidia,tier4_max9296";
            status = "okay";
            reg = <0x48>;
            csi-mode = "2x4";
            max-src = <2>;
            reset-gpios = <&tca9539_74 11 GPIO_ACTIVE_LOW>;
        };
        ser0_prim: max9295_prim@62 {
            compatible = "nvidia,tier4_max9295";
            reg = <0x62>;
            is-prim-ser;
            status = "okay";
        };
        ser0_a: max9295_a@42 {
            compatible = "nvidia,tier4_max9295";
            reg = <0x42>;
            nvidia,gmsl-dser-device = <&dsera>;
            status = "okay";
        };
        ser0_b: max9295_b@60 {
            compatible = "nvidia,tier4_max9295";
            reg = <0x60>;
            nvidia,gmsl-dser-device = <&dsera>;
            status = "okay";
        };


#define LANE_POLARITY "6"
#define TEGRA_SINTERFACE "serial_a"
        isx021_a@1b {
            nvidia,gmsl-ser-device = <&ser0_a>;
            nvidia,gmsl-dser-device = <&dsera>;
            reg = <0x1b>;
            status = "okay";
            devnode = "video0";
            reg_mux = <0>;
           
            SENSOR_COMMON

            #define VC_ID VC_ID0
            SENSOR_MODE0
            
            
            ports {
                #address-cells = <1>;
                #size-cells = <0>;
                port@0 {
                    reg = <0>;
                    cam_out0: endpoint {
                        vc-id = <0>;
                        port-index = <0>;
                        bus-width = <BUS_WIDTH>;
                        remote-endpoint = <&csi_in0>;
                    };
                };
            };
            gmsl-link {
                src-csi-port = "b";     /* Port at which sensor is connected to its serializer device. */
                dst-csi-port = "a";     /* Destination CSI port on the Jetson side, connected at deserializer. */
                serdes-csi-link = "a";  /* GMSL link sensor/serializer connected */
                csi-mode = "1x4";       /*  to sensor CSI mode. */
                st-vc = <0>;            /* Sensor source default VC ID: 0 unless overridden by sensor. */
                vc-id = <0>;            /* Destination VC ID, assigned to sensor stream by deserializer. */
                num-lanes = <BUS_WIDTH>;
                streams = "ued-u1","yuv8"; /* Types of streams sensor is streaming. */
            };
        };
        isx021_b@1c {
            nvidia,gmsl-ser-device = <&ser0_b>;
            nvidia,gmsl-dser-device = <&dsera>;
            devnode = "video1";
            reg = <0x1c>;
            status = "okay";
            reg_mux = <0>;

            SENSOR_COMMON

            #undef VC_ID
            #define VC_ID VC_ID1

            SENSOR_MODE0           
            
            ports {
                #address-cells = <1>;
                #size-cells = <0>;
                port@0 {
                    reg = <0>;
                    cam_out1: endpoint {
                        vc-id = <1>;
                        port-index = <0>;
                        bus-width = <BUS_WIDTH>;
                        remote-endpoint = <&csi_in1>;
                    };
                };
            };
            gmsl-link {
                src-csi-port = "b";     /* Port at which sensor is connected to its serializer device. */
                dst-csi-port = "a";     /* Destination CSI port on the Jetson side, connected at deserializer. */
                serdes-csi-link = "b";  /* GMSL link sensor/serializer connected */
                csi-mode = "1x4";       /*  to sensor CSI mode. */
                st-vc = <0>;            /* Sensor source default VC ID: 0 unless overridden by sensor. */
                vc-id = <1>;            /* Destination VC ID, assigned to sensor stream by deserializer. */
                num-lanes = <BUS_WIDTH>;
                streams = "ued-u1","yuv8"; /* Types of streams sensor is streaming. */
            };
        };



       };

       i2c@1 {
        status = "okay";
		reg = <1>;
		i2c-mux,deselect-on-exit;
		#address-cells = <1>;
		#size-cells = <0>;

        dserb: max9296@48 {
            compatible = "nvidia,tier4_max9296";
            status = "okay";
            reg = <0x48>;
            csi-mode = "2x4";
            max-src = <2>;
            reset-gpios = <&tca9539_74 2 GPIO_ACTIVE_HIGH>;
        };

        ser1_prim: max9295_prim@62 {
            compatible = "nvidia,tier4_max9295";
            reg = <0x62>;
            is-prim-ser;
            status = "okay";
        };
        ser1_a: max9295_a@42 {
            compatible = "nvidia,tier4_max9295";
            reg = <0x42>;
            nvidia,gmsl-dser-device = <&dserb>;
            status = "okay";
        };
        ser1_b: max9295_b@60 {
            compatible = "nvidia,tier4_max9295";
            reg = <0x60>;
            nvidia,gmsl-dser-device = <&dserb>;
            status = "okay";
        };

        #undef LANE_POLARITY
        #undef TEGRA_SINTERFACE
        #define LANE_POLARITY "0"
        #define TEGRA_SINTERFACE "serial_c"

        isx021_c@1b {
            nvidia,gmsl-ser-device = <&ser1_a>;
            nvidia,gmsl-dser-device = <&dserb>;
            reg = <0x1b>;
            status = "okay";
            devnode = "video2";

            reg_mux = <1>;
            SENSOR_COMMON

            #undef VC_ID
            #define VC_ID VC_ID0
            SENSOR_MODE0

            ports {
                #address-cells = <1>;
                #size-cells = <0>;
                port@0 {
                    reg = <0>;
                    cam_out2: endpoint {
                        vc-id = <0>;
                        port-index = <2>;
                        bus-width = <BUS_WIDTH>;
                        remote-endpoint = <&csi_in2>;
                    };
                };
            };
            gmsl-link {
                src-csi-port = "b";     /* Port at which sensor is connected to its serializer device. */
                dst-csi-port = "a";     /* Destination CSI port on the Jetson side, connected at deserializer. */
                serdes-csi-link = "a";  /* GMSL link sensor/serializer connected */
                csi-mode = "1x4";       /*  to sensor CSI mode. */
                st-vc = <0>;            /* Sensor source default VC ID: 0 unless overridden by sensor. */
                vc-id = <0>;            /* Destination VC ID, assigned to sensor stream by deserializer. */
                num-lanes = <BUS_WIDTH>;
                streams = "ued-u1","yuv8"; /* Types of streams sensor is streaming. */
            };
        };
            isx021_d@1c {
            nvidia,gmsl-ser-device = <&ser1_b>;
            nvidia,gmsl-dser-device = <&dserb>;
            devnode = "video3";
            reg = <0x1c>;
            status = "okay";

            reg_mux = <1>;
            SENSOR_COMMON

            #undef VC_ID
            #define VC_ID VC_ID1
            SENSOR_MODE0
            
            ports {
                #address-cells = <1>;
                #size-cells = <0>;
                port@0 {
                    reg = <0>;
                    cam_out3: endpoint {
                        vc-id = <1>;
                        port-index = <2>;
                        bus-width = <BUS_WIDTH>;
                        remote-endpoint = <&csi_in3>;
                    };
                };
            };
            gmsl-link {
                src-csi-port = "b";     /* Port at which sensor is connected to its serializer device. */
                dst-csi-port = "a";     /* Destination CSI port on the Jetson side, connected at deserializer. */
                serdes-csi-link = "b";  /* GMSL link sensor/serializer connected */
                csi-mode = "1x4";       /*  to sensor CSI mode. */
                st-vc = <0>;            /* Sensor source default VC ID: 0 unless overridden by sensor. */
                vc-id = <1>;            /* Destination VC ID, assigned to sensor stream by deserializer. */
                num-lanes = <BUS_WIDTH>;
                streams = "ued-u1","yuv8"; /* Types of streams sensor is streaming. */
            };
        };


		};
            };
    };
    };

/ {

    tegra-camera-platform {
        num_csi_lanes = <8>;
        max_lane_speed = <1500000>;
        min_bits_per_pixel = <10>;
        vi_peak_byte_per_pixel = <2>;
        vi_bw_margin_pct = <25>;
        isp_peak_byte_per_pixel = <5>;
        isp_bw_margin_pct = <25>;
	compatible = "nvidia, tegra-camera-platform";
	status = "okay";
        
	modules {
            module0 {
                status = "okay";
	        	badge = "isx021_rear_tier4";
		        orientation = "1";
		        position = "rear"; 
                 drivernode0 {
                    status = "okay";
                    pcl_id = "v4l2_sensor";
                    devname = "isx021 40-001b";
                    proc-device-tree = "/proc/device-tree/i2c@3180000/tca9564@70/i2c@0/isx021_a@1b";
                };
            };
            module1 {
                status = "okay";
	        	badge = "isx021_front_tier4";
		        orientation = "1";
		        position = "front"; 
                 drivernode0 {
                    status = "okay";
                    pcl_id = "v4l2_sensor";
                    devname = "isx021 40-001c";
                    proc-device-tree = "/proc/device-tree/i2c@3180000/tca9564@70/i2c@0/isx021_b@1c";
                };
            };
            module2 {
                status = "okay";
	        	badge = "isx021_left_tier4";
		        orientation = "1";
		        position = "left"; 
                 drivernode0 {
                    status = "okay";
                    pcl_id = "v4l2_sensor";
                    devname = "isx021 41-001b";
                    proc-device-tree = "/proc/device-tree/i2c@3180000/tca9564@70/i2c@1/isx021_c@1b";
                };
            };
            module3 {
                status = "okay";
	        	badge = "isx021_right_tier4";
		        orientation = "1";
		        position = "right"; 
                 drivernode0 {
                    status = "okay";
                    pcl_id = "v4l2_sensor";
                    devname = "isx021 41-001c";
                    proc-device-tree = "/proc/device-tree/i2c@3180000/tca9564@70/i2c@1/isx021_d@1c";
                };
            };
        };
    };
};
