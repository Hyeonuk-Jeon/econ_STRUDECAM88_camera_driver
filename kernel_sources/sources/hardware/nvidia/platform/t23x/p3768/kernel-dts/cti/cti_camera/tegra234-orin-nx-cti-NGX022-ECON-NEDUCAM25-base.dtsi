#include "dt-bindings/clock/tegra234-clock.h"
#include "tegra234-orin-nx-cti-econ-neducam25-modes-header.dtsi"

//To do add device tree parameter to allow for remote switching of reset pin... Required for NGX022!

#define VC_ID0 "0"
#define VC_ID1 "1"
#define VC_ID0_PORTS 0 
#define VC_ID1_PORTS 1
#define NUM_LANES "4"
/ {
    tegra-capture-vi {
        status = "okay";
        num-channels = <4>;
        ports {
	    #address-cells = <1>;
	    #size-cells = <0>;
	    status = "okay";
            port@0 {
		reg = <0>;
                status = "okay";
                vi_in0: endpoint {
		            vc-id = <VC_ID0_PORTS>;
                    port-index = <2>;
                    status = "okay";
                    bus-width = <4>;
		    remote-endpoint = <&csi_out0>;
                };
            };
            port@1 {
                status = "okay";
                reg = <1>;
                vi_in1: endpoint {
                    vc-id = <VC_ID1_PORTS>;
                    port-index = <2>;
                    status = "okay";
                    bus-width = <4>;
                    remote-endpoint = <&csi_out1>;
                };
            };
            port@2 {
                status = "okay";
                reg = <2>;
                vi_in2: endpoint {
                    vc-id = <VC_ID0_PORTS>;
                    port-index = <0>;
                    status = "okay";
                    bus-width = <4>;
                    remote-endpoint = <&csi_out2>;
                };
                
            };
            port@3 {
                status = "okay";
                reg = <3>;
                vi_in3: endpoint {
                    vc-id = <VC_ID1_PORTS>;
                    port-index = <0>;
                    status = "okay";
                    bus-width = <4>;
                    remote-endpoint = <&csi_out3>;
                };

            };


    };
    };

    host1x@13e00000 {
        nvcsi@15a00000 {
	    num-channels = <4>;
	    #address-cells = <1>;
	    #size-cells = <0>;
            status = "okay";
            channel@0 {
                status = "okay";
		        reg = <0>;
                ports {
		            #address-cells = <1>;
		            #size-cells = <0>;
                    port@0 {
                        status = "okay";
		            	reg = <0>;
                        csi_in0: endpoint@0 {
                            status = "okay";
                            port-index = <2>;
			                bus-width = <4>;
                            remote-endpoint = <&cam_out0>;
                        };
                    };
                    port@1 {
                        status = "okay";
		            	reg = <1>;
                        csi_out0: endpoint@1 {
                            status = "okay";
			                port-index = <2>;
			                bus-width = <4>;
			                remote-endpoint = <&vi_in0>;
                        };
                    };
                };
            };
            channel@1 {
                status = "okay";
            reg = <1>;
            ports {
                #address-cells = <1>;
                #size-cells = <0>;

                port@0 {
                            reg = <0>;
                            status = "okay";
                            csi_in1: endpoint@2 {
                                status = "okay";
                                port-index = <2>;
                                bus-width = <4>;
                                remote-endpoint = <&cam_out1>;
                            };
                        };
                        port@1 {
                            status = "okay";
                              reg = <1>;
                            csi_out1: endpoint@3 {
                                status = "okay";
                    port-index = <2>;
                    bus-width = <4>;
                    remote-endpoint = <&vi_in1>;
                            };
                        };
                    };
                };
            channel@2 {
                status = "okay";
            reg = <2>;
            ports {
                #address-cells = <1>;
                #size-cells = <0>;

                port@0 {
                            reg = <0>;
                            status = "okay";
                            csi_in2: endpoint@4 {
                                status = "okay";
                                port-index = <0>;
                                bus-width = <4>;
                                remote-endpoint = <&cam_out2>;
                            };
                        };
                        port@1 {
                            status = "okay";
                              reg = <1>;
                            csi_out2: endpoint@5 {
                                status = "okay";
                    port-index = <0>;
                    bus-width = <4>;
                    remote-endpoint = <&vi_in2>;
                            };
                        };
                    };
                };
            channel@3{
                status = "okay";
            reg = <3>;
            ports {
                #address-cells = <1>;
                #size-cells = <0>;

                port@0 {
                            reg = <0>;
                            status = "okay";
                            csi_in3: endpoint@6 {
                                status = "okay";
                                port-index = <0>;
                                bus-width = <4>;
                                remote-endpoint = <&cam_out3>;
                            };
                        };
                        port@1 {
                            status = "okay";
                              reg = <1>;
                            csi_out3: endpoint@7 {
                                status = "okay";
                    port-index = <0>;
                    bus-width = <4>;
                    remote-endpoint = <&vi_in3>;
                            };
                        };
                    };
                };

            };
    };


    i2c@3180000 {
        status = "okay";
        #address-cells = <1>;
        #size-cells = <0>;
        neducam25_a@43 {
            SENSOR_COMMON
            devnode = "video0";
            reg = <0x43>;
            software-reset-en; //use software reset instead of hardware reset
            camera_mipi_lanes = <4>;
            deser-addr = <0x30>;
            ser-alias = <0x21>;
            expander-alias = <0x50>;
            sio-port = "A";

#define TEGRA_SINTERFACE "serial_c" 
#define LANE_POLARITY   "0"
#define LOCAL_VC_ID VC_ID0
            
            SENSOR_MODE0
            SENSOR_MODE1
            SENSOR_MODE2

            ports{
                #address-cells = <1>;
                #size-cells = <0>;
                port@0 {
                    reg = <0>;
                    cam_out0: endpoint {
                        port-index = <2>;
                        bus-width = <4>;
                        vc-id = <0>;
                        remote-endpoint = <&csi_in0>;
                    };
                };
            };
        };
        neducam25_b@44 {
            SENSOR_COMMON
            devnode = "video1";
            reg = <0x44>;
            software-reset-en; //use software reset instead of hardware reset
            camera_mipi_lanes = <4>;
            deser-addr = <0x30>;
            ser-alias = <0x22>;
            expander-alias = <0x51>;
            sio-port = "B";

#undef LOCAL_VC_ID
#define LOCAL_VC_ID VC_ID1

                SENSOR_MODE0
                SENSOR_MODE1
                SENSOR_MODE2


            ports{
                #address-cells = <1>;
                #size-cells = <0>;
                port@0 {
                    reg = <0>;
                    cam_out1: endpoint {
                        port-index = <2>;
                        bus-width = <4>;
                        vc-id = <1>;
                        remote-endpoint = <&csi_in1>;
                    };
                };
            };
        };

        neducam25_c@45 {
            SENSOR_COMMON
            devnode = "video2";
            reg = <0x45>;
            software-reset-en; //use software reset instead of hardware reset
            camera_mipi_lanes = <4>;
            deser-addr = <0x34>;
            ser-alias = <0x23>;
            expander-alias = <0x52>;
            sio-port = "A";

#undef LOCAL_VC_ID
#define LOCAL_VC_ID VC_ID0
#undef TEGRA_SINTERFACE
#undef LANE_POLARITY
#define TEGRA_SINTERFACE "serial_a" 
#define LANE_POLARITY "6"
                SENSOR_MODE0
                SENSOR_MODE1
                SENSOR_MODE2


            ports{
                #address-cells = <1>;
                #size-cells = <0>;
                port@0 {
                    reg = <0>;
                    cam_out2: endpoint {
                        port-index = <0>;
                        bus-width = <4>;
                        vc-id = <0>;
                        remote-endpoint = <&csi_in2>;
                    };
                };
            };
        };
        neducam25_d@46 {
            SENSOR_COMMON
            devnode = "video3";
            reg = <0x46>;
            software-reset-en; //use software reset instead of hardware reset
            camera_mipi_lanes = <4>;
            deser-addr = <0x34>;
            ser-alias = <0x24>;
            expander-alias = <0x53>;
            sio-port = "B";

#undef LOCAL_VC_ID
#define LOCAL_VC_ID VC_ID1

                SENSOR_MODE0
                SENSOR_MODE1
                SENSOR_MODE2

            ports{
                #address-cells = <1>;
                #size-cells = <0>;
                port@0 {
                    reg = <0>;
                    cam_out3: endpoint {
                        port-index = <0>;
                        bus-width = <4>;
                        vc-id = <1>;
                        remote-endpoint = <&csi_in3>;
                    };
                };
            };
        };
         

    };



    tegra-camera-platform {
        num_csi_lanes = <8>;
        max_lane_speed = <1500000>;
        min_bits_per_pixel = <10>;
        vi_peak_byte_per_pixel = <2>;
        vi_bw_margin_pct = <25>;
        isp_peak_byte_per_pixel = <5>;
        isp_bw_margin_pct = <25>;
	compatible = "nvidia, tegra-camera-platform";
	status = "okay";
        
	modules {
        module0 {
            status = "okay";
            badge = "neducam25_top";
            position = "top";
            orientation = "1";
            drivernode0 {
                status = "okay";
                pcl_id = "v4l2_sensor";
                devname = "neducam25 8-0043";
                proc-device-tree = "/proc/device-tree/i2c@3180000/neducam25_a@43";
            };
        };

        module1 {
                status = "okay";
                badge = "neducam25_center";
                position = "center";
                orientation = "1";
                drivernode0 {
                status = "okay";
                pcl_id = "v4l2_sensor";
                devname = "neducam25 8-0044";
                proc-device-tree = "/proc/device-tree/i2c@3180000/neducam25_b@44";
            };
        };

        module2 {
            status = "okay";
            badge = "neducam25_bottom";
            position = "bottom";
            orientation = "1";
            drivernode0 {
                status = "okay";
                pcl_id = "v4l2_sensor";
                devname = "neducam25 8-0045";
                proc-device-tree = "/proc/device-tree/i2c@3180000/neducam25_c@45";
            };
        };
        module3 {
            status = "okay";
            badge = "neducam25_centerleft";
            position = "center-left";
            orientation = "1";
            drivernode0 {
                pcl_id = "v4l2_sensor";
                devname = "neducam25 8-0046";
                proc-device-tree = "/proc/device-tree/i2c@3180000/neducam25_d@46";
            };
        };

        };
    };
};
