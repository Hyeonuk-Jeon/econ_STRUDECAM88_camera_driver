#define SENSOR_COMMON \
    status = "okay"; \
    sensor_model = "ar0234"; \
    avdd-reg = "vana"; \
    iovdd-reg = "vif"; \
    clock-frequency = <24000000>; \
    vana-supply = <&battery_reg>; \
