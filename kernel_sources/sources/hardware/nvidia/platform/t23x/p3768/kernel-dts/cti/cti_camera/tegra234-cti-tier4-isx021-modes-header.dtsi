#define SENSOR_COMMON \
                    def-addr = <0x1a>; \
                    clock-names = "extperiph1", "pllp_grtba"; \
                    clocks = <&bpmp_clks TEGRA234_CLK_EXTPERIPH1>,<&bpmp_clks TEGRA234_CLK_EXTPERIPH1>; \
                    mclk = "extperiph1"; \
                    compatible = "nvidia,tier4_isx021"; \
                    physical_w = "15.0"; \
                    physical_h = "12.5"; \
                    sensor_model = "isx021"; \
                    fsync-mode = "true"; \
                    distortion-correction = "false"; \
                    auto-exposure = "true"; \
                    post_crop_frame_drop = "0"; \
                    use_decibel_gain = "true"; \
                    use_sensor_mode_id = "true";

