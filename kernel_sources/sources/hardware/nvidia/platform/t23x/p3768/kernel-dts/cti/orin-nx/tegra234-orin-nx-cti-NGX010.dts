#include "tegra234-orin-nx-cti-base.dtsi"

/{
    nvidia,dtsfilename = "tegra234-orin-nx-cti-NGX010.dts";
    
    model = "CTI Rudi-NX + Orin NX";
    //enable serial connections
    // UART 0 /dev/ttyTHS1
    serial@3110000 {
        status = "okay";
    };
    // UART 1 /dev/ttyTHS0
    serial@3100000 {/* UARTA, for 40 pin header */
        status = "okay";
    };
    
    fixed-regulators {
        regulator@200 {
            /delete-property/ gpio;
        };
    };
    
    pwm-fan {
        status = "disabled";
        /delete-property/ pwms;
    };

    /**define i2c-0*/
    i2c@c240000{
		status = "okay";
		
	};

    /** define tca9539 on i2c-1*/
    i2c@c250000 {
        status = "okay";
        cam_gpios:tca9539@74{
            status = "okay";
            compatible="ti,tca9539";
            vcc-supply = <&vdd_1v8_sys>;
            gpio-controller;
            #gpio-cells=<2>;
            reg=<0x74>;
        };
    };
    
    tegra_xudc: xudc@3550000 {
		status = "okay";
		phys =	<&{/xusb_padctl@3520000/pads/usb2/lanes/usb2-0}>;
		phy-names = "usb2-0";
		nvidia,xusb-padctl = <&xusb_padctl>;
	};
    
    xusb_padctl@3520000 {
        ports {
			usb2-0 {
                connector {
                    /delete-property/ id-gpios;
                    vbus-gpios = <&tegra_main_gpio TEGRA234_MAIN_GPIO(Z,1) GPIO_ACTIVE_LOW>;
                };
               
			};
            usb3-0 {
				nvidia,usb2-companion = <2>;
				status = "okay";
			};
        };
    };

};

