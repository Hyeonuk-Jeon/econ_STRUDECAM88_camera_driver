#define SENSOR_COMMON \
    compatible = "framos,imx715"; \
    reg = <0x1a>; \
    clocks = <&bpmp_clks TEGRA234_CLK_EXTPERIPH1>, \
             <&bpmp_clks TEGRA234_CLK_EXTPERIPH1>; \
    clock-names = "extperiph1", "pllp_grtba"; \
    mclk = "extperiph1"; \
    clock-frequency = <37125000>; \
    vana-supply = <&battery_reg>; \
    vif-supply = <&vdd_1v8_sys>; \
    avdd-reg = "vana"; \
    iovdd-reg = "vif"; \
    physical_w = "15.00"; \
    physical_h = "12.50"; \
    sensor_model = "imx715"; \
    post_crop_frame_drop = "0"; \
    use_decibel_gain = "true"; \
    delayed_gain = "false"; \
    use_sensor_mode_id = "false";

#define SENSOR_MODE0_2LANE \
    mode0 { \
        mclk_khz = "37125"; \
        num_lanes = "2"; \
        tegra_sinterface = TEGRA_SINTERFACE; \
        phy_mode = "DPHY"; \
        discontinuous_clk = "no"; \
        dpcm_enable = "false"; \
        cil_settletime = "0"; \
        lane_polarity = LANE_POLARITY; \
        active_w = "3864"; \
        active_h = "2192"; \
        dynamic_pixel_bit_depth = "10"; \
        csi_pixel_bit_depth = "10"; \
        mode_type = "bayer"; \
        pixel_phase = "gbrg"; \
        readout_orientation = "0"; \
        line_length = "6600"; \
        inherent_gain = "1"; \
        pix_clk_hz = "415800000"; \
        gain_factor = "10"; \
        min_gain_val = "0"; \
        max_gain_val = "720"; \
        step_gain_val = "3"; \
        default_gain = "0"; \
        min_hdr_ratio = "1"; \
        max_hdr_ratio = "64"; \
        framerate_factor = "1000000"; \
        min_framerate = "1500000"; \
        max_framerate = "44000000"; \
        step_framerate = "1"; \
        default_framerate= "44000000"; \
        exposure_factor = "1000000"; \
        min_exp_time = "42"; \
        max_exp_time = "660000"; \
        step_exp_time = "1"; \
        default_exp_time = "10000"; \
        embedded_metadata_height = "1"; \
    };

