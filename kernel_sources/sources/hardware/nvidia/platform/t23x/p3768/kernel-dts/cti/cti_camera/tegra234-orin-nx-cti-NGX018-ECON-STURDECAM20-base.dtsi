#include "dt-bindings/clock/tegra234-clock.h"

#define CAM_LANES 4
#define CAM_LANES_STRING "4"
#define TRIGGER_SEL TEGRA234_MAIN_GPIO(I,0) //CAM0_RST

#define CAM0_PWDN	TEGRA234_MAIN_GPIO(H, 6)
// trig 	- 	GPIO3 PR.00 	- 	MFP7
// reset 	- 	GPIO3 PQ.05 	- 	MFP8
// boot 	- 	GPIO3 PCC.03 	- 	MFP9
// int 		- 	GPIO3 PCC.01 	- 	MFP10
#define DESER_RESET TEGRA234_MAIN_GPIO(Q, 5)
#define DESER_BOOT  TEGRA234_AON_GPIO(CC, 3)

#define VC_ID0 "1"
#define VC_ID1 "0"
#define VC_ID0_PORTS 1 
#define VC_ID1_PORTS 0
#define MAX929X_AB 1
#define MAX929X_A  0

/ {
    gpio@2200000 {
		status = "okay";
		camera-control-output-low {
			gpio-hog;
			output-low;
			gpios = <CAM0_PWDN 0 DESER_RESET 0>;
			labels = "cam0-pwdn", "deser-reset";
			status = "okay";
		};
	};

	gpio@c2f0000 {
		status = "okay";
		camera-control-output-low-aon {
			gpio-hog;
			output-low;
			gpios = <DESER_BOOT 0>;
			label = "deser-boot";
			status = "okay";
		};
	};

    i2c@3180000 {
        status = "okay";
        #address-cells = <1>;
        #size-cells = <0>;
        ar0230_a@43 {
            status = "okay";
            compatible = "nvidia,ar0230";
            reg = <0x43>;
            sensor_model = "ar0230";
            avdd-reg = "vana";
            iovdd-reg = "vif";
            clocks = <&bpmp TEGRA234_CLK_EXTPERIPH1>,<&bpmp TEGRA234_CLK_EXTPERIPH1>;
            clock-names = "extperiph1","pllp_grtba";
            mclk = "extperiph1";
            clock-frequency = <24000000>;
            trigger-gpios = <&tegra_main_gpio TRIGGER_SEL GPIO_ACTIVE_LOW>;
            default-trigger = "internal";
            devnode = "video0";
            
            use_sensor_mode_id = "false";
            camera_mipi_lanes = <CAM_LANES>;
            camera-mipi-clk = <1200>;
            sio-port = "A";
            port-split = <MAX929X_AB>;

#define LOCAL_VC_ID VC_ID0
#define TEGRA_SINTERFACE "serial_a"
#define LANE_POLARITY "6" //6
#include "nilecam20_cuxvr_mode.dtsi"


            ports {
                #address-cells = <1>;
                #size-cells = <0>;
                
                port@0 {
                    reg = <0>;
                    cam_out0: endpoint {
                        status = "okay";
                        vc-id = <VC_ID0_PORTS>;
                        port-index = <0>;
                        bus-width = <4>;
                        remote-endpoint = <&csi_in0>;
                    };
                };
            };    
        };

        ar0230_b@44 {
            status = "okay";
            compatible = "nvidia,ar0230";
            reg = <0x44>;
            sensor_model = "ar0230";
            avdd-reg = "vana";
            iovdd-reg = "vif";
            clocks = <&bpmp TEGRA234_CLK_EXTPERIPH1>,<&bpmp TEGRA234_CLK_EXTPERIPH1>;
            clock-names = "extperiph1","pllp_grtba";
            mclk = "extperiph1";
            clock-frequency = <24000000>;
            trigger-gpios = <&tegra_main_gpio TRIGGER_SEL GPIO_ACTIVE_LOW>;
            default-trigger = "internal";
            devnode = "video1";
            
            use_sensor_mode_id = "false";
            camera_mipi_lanes = <CAM_LANES>;
            camera-mipi-clk = <1200>;
            sio-port = "B";
            port-split = <MAX929X_AB>;

#undef TEGRA_SINTERFACE
#undef LOCAL_VC_ID
#undef LANE_POLARITY
#define LOCAL_VC_ID VC_ID1
#define TEGRA_SINTERFACE "serial_c"
#define LANE_POLARITY "0" 
#include "nilecam20_cuxvr_mode.dtsi"


            ports {
                #address-cells = <1>;
                #size-cells = <0>;
                
                port@0 {
                    reg = <0>;
                    cam_out1: endpoint {
                        status = "okay";
                        vc-id = <VC_ID1_PORTS>;
                        port-index = <2>;
                        bus-width = <4>;
                        remote-endpoint = <&csi_in1>;
                    };
                };
            };    
        };
    };

    tegra-capture-vi {
        status = "okay";
        num-channels = <2>;
        ports {
        #address-cells = <1>;
        #size-cells = <0>;
        status = "okay";
            port@0 {
                reg = <0>;
                status = "okay";
                vi_in0: endpoint {
                    vc-id = <VC_ID0_PORTS>;
                    port-index = <0>;
                    status = "okay";
                    bus-width = <4>;
                    remote-endpoint = <&csi_out0>;
                };
            };
            port@1 {
                status = "okay";
                reg = <1>;
                vi_in1: endpoint {
                    vc-id = <VC_ID1_PORTS>;
                    port-index = <2>;
                    status = "okay";
                    bus-width = <4>;
                    remote-endpoint = <&csi_out1>;
                };
            };
        };
    };

    host1x@13e00000 {
        nvcsi@15a00000 {
            num-channels = <2>;
            #address-cells = <1>;
            #size-cells = <0>;
            status = "okay";
            channel@0 {
                status = "okay";
                reg = <0>;
                ports {
                    #address-cells = <1>;
                    #size-cells = <0>;
                    port@0 {
                        status = "okay";
                        reg = <0>;
                        csi_in0: endpoint@0 {
                            status = "okay";
                            port-index = <0>;
                            bus-width = <4>;
                            remote-endpoint = <&cam_out0>;
                        };
                    };
                    port@1 {
                        status = "okay";
                        reg = <1>;
                        csi_out0: endpoint@1 {
                            status = "okay";
                            port-index = <0>;
                            bus-width = <4>;
                            remote-endpoint = <&vi_in0>;
                        };
                    };
                };
            };
            channel@1 {
                status = "okay";
                reg = <1>;
                ports {
                    #address-cells = <1>;
                    #size-cells = <0>;
                    port@0 {
                        reg = <0>;
                        status = "okay";
                        csi_in1: endpoint@2 {
                            status = "okay";
                            port-index = <2>;
                            bus-width = <4>;
                            remote-endpoint = <&cam_out1>;
                        };
                    };
                    port@1 {
                        status = "okay";
                        reg = <1>;
                        csi_out1: endpoint@3 {
                            status = "okay";
                            port-index = <2>;
                            bus-width = <4>;
                            remote-endpoint = <&vi_in1>;
                        };
                    };
                };
            };
        };
    };
    tegra-camera-platform {
        num_csi_lanes = <8>;
        max_lane_speed = <1500000>;
        min_bits_per_pixel = <16>;
        vi_peak_byte_per_pixel = <2>;
        vi_bw_margin_pct = <67>;
        isp_peak_byte_per_pixel = <5>;
        isp_bw_margin_pct = <25>;
        compatible = "nvidia, tegra-camera-platform";
        status = "okay";
        
        modules {
            module0 {
                status = "okay";
                badge = "ar0230_a";
                orientation = "1";
                position = "rear1"; 
                 drivernode0 {
                    status = "okay";
                    pcl_id = "v4l2_sensor";
                    devname = "ar0230 2-0043";
                    proc-device-tree = "/proc/device-tree/i2c@3180000/ar0230_a@43";
                };
            };
            module1 {
                status = "okay";
                badge = "ar0230_b";
                orientation = "1";
                position = "rear2"; 
                 drivernode0 {
                    status = "okay";
                    pcl_id = "v4l2_sensor";
                    devname = "ar0230 2-0044";
                    proc-device-tree = "/proc/device-tree/i2c@3180000/ar0230_b@44";
                };
            };
        };
    };
};
