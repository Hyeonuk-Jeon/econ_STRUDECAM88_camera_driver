		ar0234hawk_e@18 {
			status = "okay";
			compatible = "onsemi,ar0234hawk";
			devnode = "video4";
			reg = <0x18>;
			reg_mux = <0>;
			def-addr = <0x18>;
			clocks = <&bpmp_clks TEGRA234_CLK_EXTPERIPH1>,<&bpmp_clks TEGRA234_CLK_EXTPERIPH1>;
			clock-names = "extperiph1", "pllp_grtba";
			mclk = "extperiph1";
			channel = "a";
			link = "a";
			has-eeprom;
			reset-gpios = <&tca9539_74 2 GPIO_ACTIVE_HIGH>;
			pwdn-gpios = <&tca9539_74 3 GPIO_ACTIVE_HIGH>;
            master-mode = <0>; //hardware trigger by default 0=trigger-mode 1=master-mode
			physical_w = "15.0";
			physical_h = "12.5";
			sensor_model = "ar0234hawk";
			sync_sensor = "HAWK1";
			sync_sensor_index = <1>;

			post_crop_frame_drop = "0";
			use_sensor_mode_id = "true";
#undef TEGRA_SINTERFACE
#define TEGRA_SINTERFACE "serial_e"
#undef MODE_VC
#define MODE_VC "0"	

			LI_HAWK_10FPS
	
			ports {
				#address-cells = <1>;
				#size-cells = <0>;
				port@0 {
					reg = <0>;
