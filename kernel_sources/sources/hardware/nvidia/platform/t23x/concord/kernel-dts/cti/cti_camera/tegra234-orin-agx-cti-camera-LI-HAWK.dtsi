//#include "tegra234-orin-agx-cti-csi.dtsi"
#include "dt-bindings/clock/tegra234-clock.h"

#define RST_IO_EXP TEGRA234_MAIN_GPIO(AC,1)
#define PWM_CALIB_GPIO TEGRA234_MAIN_GPIO(H,7) //CAM0_PWDN
#define TRIGGER_SEL TEGRA234_MAIN_GPIO(I,0) //CAM0_RST
#define PWR_EN		TEGRA234_MAIN_GPIO(AC, 7)
#define CAM_LANES 4
#define CAM_LANES_STRING "4" 
#define TEGRA_SINTERFACE "serial_g"
#define MODE_VC "0"
#define SERDES_PIX_CLK_HZ "590000000"
#define PIX_CLK_HZ "90000000"
#include "tegra234-orin-agx-cti-camera-LI-HAWK-modes.dtsi"
//serdes_pix_clk_hz = "299000000"; //orig val

/ {

	gpio@2200000 {
		camera-control-output-high {
			status = "okay";
			gpio-hog;
			gpios = <RST_IO_EXP 0>;
			output-high;
			label = "rst-io-expender"; 
		};
		camera-control-output-low {
			status = "okay";
			gpio-hog;
			gpios = <TRIGGER_SEL 0>;
			output-low;
			label = "trigger_sel";
		};
	};

	

    i2c@31e0000 {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;
        tca9544@72 {
	    status = "okay";
	    compatible = "nxp,pca9544";
	    reg = <0x72>;
	    #address-cells = <1>;
	    #size-cells = <0>;
	    vcc-supply = <&vdd_1v8_sys>;
	    vcc-pullup-supply = <&battery_reg>;
	    vcc_lp = "vcc";
	    skip_mux_detect = "yes";
	    force_bus_start = <0x1e>;
            i2c@0 {
                status = "okay";
		reg = <0>;
		i2c-mux,deselect-on-exit;
		#address-cells = <1>;
		#size-cells = <0>;

		max96712_a@60 { //just needs to exist for the reg r/w
			compatible = "nvidia,max96712";
			reg = <0x60>;
			channel = "a";
			//status = "okay";
		};

		bmi088@69 {
			compatible = "bmi,bmi088";
			reg = <0x69>;
			status = "okay";
			accel_i2c_addr = <0x19>;
			accel_matrix = [01 00 00 00 01 00 00 00 01];
			gyro_matrix = [01 00 00 00 01 00 00 00 01];
		};
	
		ar0234hawk_a@18 {
			status = "okay";
			compatible = "onsemi,ar0234hawk";
			devnode = "video0";
			reg = <0x18>;
			def-addr = <0x18>;
			clocks = <&bpmp_clks TEGRA234_CLK_EXTPERIPH1>,<&bpmp_clks TEGRA234_CLK_EXTPERIPH1>;
			clock-names = "extperiph1", "pllp_grtba";
			mclk = "extperiph1";
			channel = "a";
			link = "a";
			has-eeprom;
			reset-gpios = <&tca9539_74 0 GPIO_ACTIVE_HIGH>;
			pwdn-gpios = <&tca9539_74 1 GPIO_ACTIVE_HIGH>;
            master-mode = <0>; //hardware trigger by default 0=trigger-mode 1=master-mode
			physical_w = "15.0";
			physical_h = "12.5";
			sensor_model = "ar0234hawk";
			sync_sensor = "HAWK1";
			sync_sensor_index = <1>;
			reg_mux = <0>;	
			post_crop_frame_drop = "0";
			use_sensor_mode_id = "true";
			LI_HAWK_10FPS		
				
			ports {
				#address-cells = <1>;
				#size-cells = <0>;
				port@0 {
					reg = <0>;
					cam_out0: endpoint {
						vc-id = <0>;
						port-index = <6>;
						bus-width = <CAM_LANES>;
						remote-endpoint = <&csi_in0>;
					};
				};
			};	

		};

		ar0234hawk_b@10 {
			compatible = "onsemi,ar0234hawk";
			devnode = "video1"; 
			reg = <0x10>;
			status = "okay";
			def-addr = <0x10>;
			clocks = <&bpmp_clks TEGRA234_CLK_EXTPERIPH1>,<&bpmp_clks TEGRA234_CLK_EXTPERIPH1>;
			clock-names = "extperiph1","pllp_grtba";
			mclk = "extperiph1";
			channel = "n";
			link = "a";
			has-eeprom;
			reset-gpios = <&tca9539_74 0 GPIO_ACTIVE_HIGH>;
			pwdn-gpios = <&tca9539_74 1 GPIO_ACTIVE_HIGH>;
			master-mode = <0>; //hardware trigger by default 0=trigger-mode 1=master-mode
            physical_w = "15.0";
			physical_h = "12.5";
			sensor_model = "ar0234hawk";
			sync_sensor = "HAWK1";
			sync_sensor_index = <2>;
			post_crop_frame_drop = "0";
			use_sensor_mode_id = "true";
//#undef TEGRA_SINTERFACE
//#define TEGRA_SINTERFACE "serial_g"
#undef MODE_VC
#define MODE_VC "1"
			LI_HAWK_10FPS	
		
			ports {
				#address-cells = <1>;
				#size-cells = <0>;
				port@0 {
					reg = <0>;
					cam_out1: endpoint {
						vc-id = <1>;
						port-index = <6>;
						bus-width = <CAM_LANES>;
						remote-endpoint = <&csi_in1>;
					};
				};
			};	
		};
	        ar0234hawk_c@20 {
			status = "okay";
			compatible = "onsemi,ar0234hawk";
			devnode = "video2";
			reg = <0x20>;
			def-addr = <0x20>;
			clocks = <&bpmp_clks TEGRA234_CLK_EXTPERIPH1>,<&bpmp_clks TEGRA234_CLK_EXTPERIPH1>;
			clock-names = "extperiph1", "pllp_grtba";
			mclk = "extperiph1";
			channel = "a";
			link = "b";
			//has-eeprom;
			reset-gpios = <&tca9539_74 0 GPIO_ACTIVE_HIGH>;
			pwdn-gpios = <&tca9539_74 1 GPIO_ACTIVE_HIGH>;
            master-mode = <0>; //hardware trigger by default 0=trigger-mode 1=master-mode
			physical_w = "15.0";
			physical_h = "12.5";
			sensor_model = "ar0234hawk";
			sync_sensor = "HAWK1";
			sync_sensor_index = <1>;
			reg_mux = <0>;	
			post_crop_frame_drop = "0";
			use_sensor_mode_id = "true";
#undef MODE_VC
#define MODE_VC "2"
			LI_HAWK_10FPS		
				
			ports {
				#address-cells = <1>;
				#size-cells = <0>;
				port@0 {
					reg = <0>;
					cam_out2: endpoint {
						vc-id = <2>;
						port-index = <6>;
						bus-width = <CAM_LANES>;
						remote-endpoint = <&csi_in2>;
					};
				};
			};	

		};

		ar0234hawk_d@11 {
			compatible = "onsemi,ar0234hawk";
			devnode = "video3"; 
			reg = <0x11>;
			status = "okay";
			def-addr = <0x11>;
			clocks = <&bpmp_clks TEGRA234_CLK_EXTPERIPH1>,<&bpmp_clks TEGRA234_CLK_EXTPERIPH1>;
			clock-names = "extperiph1","pllp_grtba";
			mclk = "extperiph1";
			channel = "n";
			link = "b";
			//has-eeprom;
			reset-gpios = <&tca9539_74 0 GPIO_ACTIVE_HIGH>;
			pwdn-gpios = <&tca9539_74 1 GPIO_ACTIVE_HIGH>;
			master-mode = <0>; //hardware trigger by default 0=trigger-mode 1=master-mode
            physical_w = "15.0";
			physical_h = "12.5";
			sensor_model = "ar0234hawk";
			sync_sensor = "HAWK1";
			sync_sensor_index = <1>;
			post_crop_frame_drop = "0";
			use_sensor_mode_id = "true";
//#undef TEGRA_SINTERFACE
//#define TEGRA_SINTERFACE "serial_g"
#undef MODE_VC
#define MODE_VC "3"
			LI_HAWK_10FPS	
		
			ports {
				#address-cells = <1>;
				#size-cells = <0>;
				port@0 {
					reg = <0>;
					cam_out3: endpoint {
						vc-id = <3>;
						port-index = <6>;
						bus-width = <CAM_LANES>;
						remote-endpoint = <&csi_in3>;
					};
				};
			};	
		};
            };

	    i2c@1 {
		status = "okay";
		reg = <1>;
		i2c-mux,deselect-on-exit;
		#address-cells = <1>;
		#size-cells = <0>;
		
		max96712_a@60 {
			compatible = "nvidia,max96712";
			reg = <0x60>;
