#include "dt-bindings/gpio/tegra234-gpio.h"
#include "dt-bindings/clock/tegra234-clock.h"
#include "tegra234-orin-agx-cti-csi.dtsi"
#include "tegra234-orin-agx-cti-fsm-imx568-modes-header.dtsi"

#define CAM0_RST_L  TEGRA234_MAIN_GPIO(I, 0)
#define CAM0_PWDN   TEGRA234_MAIN_GPIO(H, 7)
#define CRESETB     TEGRA234_MAIN_GPIO(AC, 0)
#define XVS         TEGRA234_MAIN_GPIO(N, 1)

/ {



    tegra-capture-vi {
        status = "okay";
        num-channels = <8>;
        ports {
        #address-cells = <1>;
        #size-cells = <0>;
        status = "okay";

            port@0 {
                reg = <0>;
                status = "okay";
                vi_in0: endpoint {
                    status = "okay";
                    vc-id = <0>;
                    port-index = <0>;
                    bus-width = <4>;
                    remote-endpoint = <&csi_out0>;
                };
            };
            port@2 {
                reg = <2>;
                status = "okay";
                vi_in2: endpoint {
                    status = "okay";
                    vc-id = <0>;
                    port-index = <2>;
                    bus-width = <4>;
                    remote-endpoint = <&csi_out2>;
                };
            };
            port@4 {
                reg = <4>;
                status = "okay";
                vi_in4: endpoint {
                    status = "okay";
                    vc-id = <0>;
                    port-index = <4>;
                    bus-width = <4>;
                    remote-endpoint = <&csi_out4>;
                };
            };
            port@5 {
                reg = <5>;
                status = "okay";
                vi_in5: endpoint {
                    status = "okay";
                    vc-id = <0>;
                    port-index = <5>;
                    bus-width = <4>;
                    remote-endpoint = <&csi_out5>;
                };
            };
            
        };
    };

    host1x@13e00000 {
        nvcsi@15a00000 {
            num-channels = <8>;
            #address-cells = <1>;
            #size-cells = <0>;
                
            status = "okay";
            channel@0 {
                reg = <0>;
                status = "okay";
                ports {
                    #address-cells = <1>;
                    #size-cells = <0>;

                    port@0 {
                        status = "okay";
                        reg = <0>; 
                        csi_in0: endpoint@0 {
                            status = "okay";
                            bus-width = <4>;
                            port-index = <0>;
                            remote-endpoint = <&cam_out0>;
                        };
                    };
                    port@1 {
                        status = "okay";
                        reg = <1>;
                        csi_out0: endpoint@1 {
                            status = "okay";
                            bus-width = <4>;
                            port-index = <0>;
                            remote-endpoint = <&vi_in0>;
                        };
                    };
                };
            };
            channel@2 {
                reg = <2>;
                status = "okay";
                ports {
                    #address-cells = <1>;
                    #size-cells = <0>;

                    port@0 {
                        status = "okay";
                        reg = <0>; 
                        csi_in2: endpoint@4 {
                            status = "okay";
                            bus-width = <4>;
                            port-index = <2>;
                            remote-endpoint = <&cam_out2>;
                        };
                    };
                    port@1 {
                        status = "okay";
                        reg = <1>;
                        csi_out2: endpoint@5 {
                            status = "okay";
                            bus-width = <4>;
                            port-index = <2>;
                            remote-endpoint = <&vi_in2>;
                        };
                    };
                };
            };
            channel@4 {
                reg = <4>;
                status = "okay";
                ports {
                    #address-cells = <1>;
                    #size-cells = <0>;

                    port@0 {
                        status = "okay";
                        reg = <0>; 
                        csi_in4: endpoint@8 {
                            status = "okay";
                            bus-width = <4>;
                            port-index = <4>;
                            remote-endpoint = <&cam_out4>;
                        };
                    };
                    port@1 {
                        status = "okay";
                        reg = <1>;
                        csi_out4: endpoint@9 {
                            status = "okay";
                            bus-width = <4>;
                            port-index = <4>;
                            remote-endpoint = <&vi_in4>;
                        };
                    };
                };
            };
            channel@5 {
                reg = <5>;
                status = "okay";
                ports {
                    #address-cells = <1>;
                    #size-cells = <0>;

                    port@0 {
                        status = "okay";
                        reg = <0>; 
                        csi_in5: endpoint@10 {
                            status = "okay";
                            bus-width = <4>;
                            port-index = <6>;
                            remote-endpoint = <&cam_out5>;
                        };
                    };
                    port@1 {
                        status = "okay";
                        reg = <1>;
                        csi_out5: endpoint@11 {
                            status = "okay";
                            bus-width = <4>;
                            port-index = <6>;
                            remote-endpoint = <&vi_in5>;
                        };
                    };
                };
            };
        };
    };
    framos_platform_adapter {
        cam,use-cam-gpio = "true";
    };

    gpio@2200000 {
        camera-control-output-low {
            gpio-hog;
            output-low;
            gpios = <CAM0_RST_L 0>;
            label = "cam0-rst";
            status = "okay";
        };
        camera-control-output-high {
            gpio-hog;
            output-high;
            gpios = <CAM0_PWDN 0 CRESETB 0>;
            label = "cam0-pwdn", "cresetb";
            status = "okay";
        };
        camera-control-input {
            gpio-hog;
            input;
            gpios = <XVS 0>;
            label = "xvs";
            status = "okay";
        };

    };


    //I2C_3  
    i2c@3180000{
        tca9548_70: tca9548@70 {
            compatible = "nxp,pca9548";
            reg = <0x70>;
            #address-cells = <1>;
            #size-cells = <0>;
            skip_mux_detect;
            vcc-supply = <&vdd_1v8_sys>;
            force_bus_start = <30>;

            i2c@0 {
                reg = <0>;
                i2c-mux,deselect-on-exit;
                #address-cells = <1>;
                #size-cells = <0>;
                
                imx568_a@1a {
                    status = "okay";
                    SENSOR_COMMON
                    devnode = "video0";
#define TEGRA_SINTERFACE "serial_a"

                    SENSOR_MODE0
                    SENSOR_MODE1
                    SENSOR_MODE2
                    SENSOR_MODE3
                    SENSOR_MODE4
                    SENSOR_MODE5
                    SENSOR_MODE6
                    SENSOR_MODE7

                    ports {
                        #address-cells = <1>;
                        #size-cells = <0>;
                        port@0 {
                            reg = <0>;
                            cam_out0: endpoint {
                                port-index = <0>;
                                bus-width = <4>;
                                remote-endpoint = <&csi_in0>;
                            };
                        };
                    };
                };
            };
       
            i2c@2 {
                reg = <2>;
                i2c-mux,deselect-on-exit;
                #address-cells = <1>;
                #size-cells = <0>;
                
                imx568_c@1a {
                    status = "okay";
                    SENSOR_COMMON
                    devnode = "video1";
#undef TEGRA_SINTERFACE
#define TEGRA_SINTERFACE "serial_c"

                    SENSOR_MODE0
                    SENSOR_MODE1
                    SENSOR_MODE2
                    SENSOR_MODE3
                    SENSOR_MODE4
                    SENSOR_MODE5
                    SENSOR_MODE6
                    SENSOR_MODE7

                    ports {
                        #address-cells = <1>;
                        #size-cells = <0>;
                        port@0 {
                            reg = <0>;
                            cam_out2: endpoint {
                                port-index = <2>;
                                bus-width = <4>;
                                remote-endpoint = <&csi_in2>;
                            };
                        };
                    };
                };
            };

            i2c@4 {
                reg = <4>;
                i2c-mux,deselect-on-exit;
                #address-cells = <1>;
                #size-cells = <0>;
                
                imx568_e@1a {
                    status = "okay";
                    SENSOR_COMMON
                    devnode = "video2";
#undef TEGRA_SINTERFACE
#define TEGRA_SINTERFACE "serial_e"

                    SENSOR_MODE0
                    SENSOR_MODE1
                    SENSOR_MODE2
                    SENSOR_MODE3
                    SENSOR_MODE4
                    SENSOR_MODE5
                    SENSOR_MODE6
                    SENSOR_MODE7

                    ports {
                        #address-cells = <1>;
                        #size-cells = <0>;
                        port@0 {
                            reg = <0>;
                            cam_out4: endpoint {
                                port-index = <4>;
                                bus-width = <4>;
                                remote-endpoint = <&csi_in4>;
                            };
                        };
                    };
                };
            };

            i2c@6 {
                reg = <6>;
                i2c-mux,deselect-on-exit;
                #address-cells = <1>;
                #size-cells = <0>;
                
                imx568_g@1a {
                    status = "okay";
                    SENSOR_COMMON
                    devnode = "video3";
#undef TEGRA_SINTERFACE
#define TEGRA_SINTERFACE "serial_g"

                    SENSOR_MODE0
                    SENSOR_MODE1
                    SENSOR_MODE2
                    SENSOR_MODE3
                    SENSOR_MODE4
                    SENSOR_MODE5
                    SENSOR_MODE6
                    SENSOR_MODE7

                    ports {
                        #address-cells = <1>;
                        #size-cells = <0>;
                        port@0 {
                            reg = <0>;
                            cam_out5: endpoint {
                                port-index = <6>;
                                bus-width = <4>;
                                remote-endpoint = <&csi_in5>;
                            };
                        };
                    };
                };
            };
        };
    };



    tegra-camera-platform {
        compatible = "nvidia, tegra-camera-platform";
        num_csi_lanes = <16>;
        max_lane_speed = <1500000>;
        min_bits_per_pixel = <10>;
        vi_peak_byte_per_pixel = <2>;
        vi_bw_margin_pct = <25>;
        isp_peak_byte_per_pixel = <5>;
        isp_bw_margin_pct = <25>;

        modules {
            module0 {
                status = "okay";
                badge = "imx568_bottomleft_framos";
                orientation = "1"; 
                position = "bottomleft";
                 drivernode0 {
                    status = "okay";
                    devname = "imx568 30-001a";
                    pcl_id = "v4l2_sensor";
                    proc-device-tree = "/proc/device-tree/i2c@3180000/tca9548@70/i2c@0/imx568_a@1a";
                };
            };
            module1 {
                status = "okay";
                badge = "imx568_centerright_framos";
                orientation = "1"; 
                position = "centerright";
                 drivernode0 {
                    status = "okay";
                    devname = "imx568 32-001a";
                    pcl_id = "v4l2_sensor";
                    proc-device-tree = "/proc/device-tree/i2c@3180000/tca9548@70/i2c@2/imx568_c@1a";
                };
            };
            module2 {
                status = "okay";
                badge = "imx568_bottomright_framos";
                orientation = "1"; 
                position = "bottomright";
                 drivernode0 {
                    status = "okay";
                    devname = "imx568 34-001a";
                    pcl_id = "v4l2_sensor";
                    proc-device-tree = "/proc/device-tree/i2c@3180000/tca9548@70/i2c@4/imx568_e@1a";
                };
            };
            module3 {
                status = "okay";
                badge = "imx568_topright_framos";
                orientation = "1"; 
                position = "topright";
                 drivernode0 {
                    status = "okay";
                    devname = "imx568 36-001a";
                    pcl_id = "v4l2_sensor";
                    proc-device-tree = "/proc/device-tree/i2c@3180000/tca9548@70/i2c@6/imx568_g@1a";
                };
            };
        };
    };
};
