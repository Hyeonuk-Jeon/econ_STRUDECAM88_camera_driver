//#include "tegra234-orin-agx-cti-csi.dtsi"
#include "dt-bindings/clock/tegra234-clock.h"

#define COAX_EN TEGRA234_MAIN_GPIO(H,7) //CAM0_PWDN
#define TRIGGER_IO TEGRA234_MAIN_GPIO(R,0) //PWM1


#define CAM_LANES 4
#define CAM_LANES_STRING "4" 
#define TEGRA_SINTERFACE "serial_g"
#define MODE_VC "0"
#define SERDES_PIX_CLK_HZ "590000000" 
#define PIX_CLK_HZ "134400000"
#define TRIG_MODE <0> //manual trigger
#include "tegra234-orin-agx-cti-camera-LI-HAWK-modes.dtsi"

#define SENSOR_COMMON \
                compatible = "onsemi,ar0234owl"; \
                clocks = <&bpmp_clks TEGRA234_CLK_EXTPERIPH1>,<&bpmp_clks TEGRA234_CLK_EXTPERIPH1>; \
                clock-names = "extperiph1", "pllp_grtba"; \
                mclk = "extperiph1"; \
                master-mode = TRIG_MODE; /*hardware trigger by default 0=trigger-mode 1=master-mode */ \
                physical_w = "15.0"; \
                physical_h = "12.5"; \
                sensor_model = "ar0234owl"; \
                post_crop_frame_drop = "0"; \
                use_sensor_mode_id = "true"; \
     
            
/ {

	gpio@2200000 {
        camera-coax-en {
            status = "okay";
            gpio-hog;
            gpios = <COAX_EN 0>;
            output-high;
            label = "camera-coax-en";
        };
	};

	

    i2c@31e0000 {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;
        tca9544@72 {
	    status = "okay";
	    compatible = "nxp,pca9544";
	    reg = <0x72>;
	    #address-cells = <1>;
	    #size-cells = <0>;
	    vcc-supply = <&vdd_1v8_sys>;
	    vcc-pullup-supply = <&battery_reg>;
	    vcc_lp = "vcc";
	    skip_mux_detect = "yes";
	    force_bus_start = <0x1e>;
      i2c@0 {
                status = "okay";
		reg = <0>;
		i2c-mux,deselect-on-exit;
		#address-cells = <1>;
		#size-cells = <0>;

		max96712_a@60 { //just needs to exist for the reg r/w
			compatible = "nvidia,max96712";
			reg = <0x60>;
			channel = "a";
			//status = "okay";
		};
	
		ar0234owl_a@19 {
			status = "okay";
			devnode = "video0";
            devnode-bus = "30";
			reg = <0x19>;
            SENSOR_COMMON
			channel = "a";
			link = "a";
			reset-gpios = <&tca9539_74 0 GPIO_ACTIVE_HIGH>;
			sync_sensor = "OWL1";
			sync_sensor_index = <1>;
			reg_mux = <0>;	
            LI_HAWK_10FPS		
				
			ports {
				#address-cells = <1>;
				#size-cells = <0>;
				port@0 {
					reg = <0>;
					cam_out0: endpoint {
						vc-id = <0>;
						port-index = <6>;
						bus-width = <CAM_LANES>;
						remote-endpoint = <&csi_in0>;
					};
				};
			};	

		};
		ar0234owl_b@1a {
			status = "okay";
			devnode = "video1";
			reg = <0x1a>;
             devnode-bus = "30";
            SENSOR_COMMON
			channel = "a";
			link = "b";
			reset-gpios = <&tca9539_74 0 GPIO_ACTIVE_HIGH>;
			sync_sensor = "OWL2";
			sync_sensor_index = <2>;
			reg_mux = <0>;	
#undef MODE_VC
#define MODE_VC "1"			
            LI_HAWK_10FPS		
				
			ports {
				#address-cells = <1>;
				#size-cells = <0>;
				port@0 {
					reg = <0>;
					cam_out1: endpoint {
						vc-id = <1>;
						port-index = <6>;
						bus-width = <CAM_LANES>;
						remote-endpoint = <&csi_in1>;
					};
				};
			};	

		};

		};
	    i2c@1 {
		status = "okay";
		reg = <1>;
		i2c-mux,deselect-on-exit;
		#address-cells = <1>;
		#size-cells = <0>;
		
		max96712_a@60 {
			compatible = "nvidia,max96712";
			reg = <0x60>;
			channel = "a";
			status = "okay";
		};


		ar0234owl_c@19 {
			status = "okay";
			devnode = "video2";
			reg = <0x19>;
            SENSOR_COMMON
			reg_mux = <0>;
			channel = "a";
			link = "a";
			reset-gpios = <&tca9539_74 2 GPIO_ACTIVE_HIGH>;
			sync_sensor = "OWL1";
			sync_sensor_index = <1>;
#undef TEGRA_SINTERFACE
#define TEGRA_SINTERFACE "serial_e"
#undef MODE_VC
#define MODE_VC "0"	

			LI_HAWK_10FPS
	
			ports {
				#address-cells = <1>;
				#size-cells = <0>;
				port@0 {
					reg = <0>;
					cam_out2: endpoint {
						vc-id = <0>;
						port-index = <4>;
						bus-width = <CAM_LANES>;
						remote-endpoint = <&csi_in2>;
					};
				};
			};	

		};


        ar0234owl_d@1a {
            devnode = "video3";
            reg = <0x1a>;
            status = "okay";
            SENSOR_COMMON
            link = "b";
            channel = "a";
            reset-gpios = <&tca9539_74 2 GPIO_ACTIVE_HIGH>;
            sync_sensor = "OWL2";
            sync_sensor_index = <2>;
#undef MODE_VC
#define MODE_VC "1"
            LI_HAWK_10FPS

            ports {
                #address-cells = <1>;
                #size-cells = <0>;
                port@0 {
                    reg = <0>;
                    cam_out3: endpoint {
                        vc-id = <1>;
                        port-index = <4>;
                        bus-width = <CAM_LANES>;
                        remote-endpoint = <&csi_in3>;
                    };
                };
            };
        };

	    };


            i2c@2 {
                status = "okay";
                reg = <2>;
		i2c-mux,deselect-on-exit;
		#address-cells = <1>;
		#size-cells = <0>;
		
		max96712_a@60 {
			compatible = "nvidia,max96712";
			reg = <0x60>;
			channel = "a";
			status = "okay";
		};

		ar0234owl_e@19 {
			status = "okay";
			devnode = "video4";
            SENSOR_COMMON
			reg = <0x19>;
			reg_mux = <0>;
			channel = "a";
			link = "a";
			reset-gpios = <&tca9539_74 4 GPIO_ACTIVE_HIGH>;
			sync_sensor = "OWL1";
			sync_sensor_index = <1>;

#undef TEGRA_SINTERFACE
#define TEGRA_SINTERFACE "serial_c"
#undef MODE_VC
#define MODE_VC "0"	

			LI_HAWK_10FPS
	
			ports {
				#address-cells = <1>;
				#size-cells = <0>;
				port@0 {
					reg = <0>;
					cam_out4: endpoint {
						vc-id = <0>;
						port-index = <2>;
						bus-width = <CAM_LANES>;
						remote-endpoint = <&csi_in4>;
					};
				};
			};	

		};
		ar0234owl_f@1a {
			status = "okay";
			devnode = "video5";
            SENSOR_COMMON
			reg = <0x1a>;
			channel = "a";
			link = "b";
			reset-gpios = <&tca9539_74 4 GPIO_ACTIVE_HIGH>;
			sync_sensor = "OWL2";
			sync_sensor_index = <2>;

#undef MODE_VC
#define MODE_VC "1"	

			LI_HAWK_10FPS
	
			ports {
				#address-cells = <1>;
				#size-cells = <0>;
				port@0 {
					reg = <0>;
					cam_out5: endpoint {
						vc-id = <1>;
						port-index = <2>;
						bus-width = <CAM_LANES>;
						remote-endpoint = <&csi_in5>;
					};
				};
			};	

		};

      };
                
            i2c@3 {
                status = "okay";
		reg = <3>;
		i2c-mux,deselect-on-exit;
		#address-cells = <1>;
		#size-cells = <0>;
				

		max96712_a@60 {
			compatible = "nvidia,max96712";
			reg = <0x60>;
			channel = "a";
			status = "okay";
		};

		ar0234owl_g@19 {
			status = "okay";
			devnode = "video6";
            SENSOR_COMMON
			reg = <0x19>;
			reg_mux = <0>;
			channel = "a";
			link = "a";
			reset-gpios = <&tca9539_74 6 GPIO_ACTIVE_HIGH>;


			sync_sensor = "OWL1";
			sync_sensor_index = <1>;

#undef TEGRA_SINTERFACE
#define TEGRA_SINTERFACE "serial_a"
#undef MODE_VC
#define MODE_VC "0"	

			LI_HAWK_10FPS
	
			ports {
				#address-cells = <1>;
				#size-cells = <0>;
				port@0 {
					reg = <0>;
					cam_out6: endpoint {
						vc-id = <0>;
						port-index = <0>;
						bus-width = <CAM_LANES>;
						remote-endpoint = <&csi_in6>;
					};
				};
			};	

		};
		ar0234owl_h@1a {
			status = "okay";
			devnode = "video7";
			reg = <0x1a>;
            SENSOR_COMMON
			channel = "a";
			link = "b";
			reset-gpios = <&tca9539_74 6 GPIO_ACTIVE_HIGH>;

			sync_sensor = "OWL2";
			sync_sensor_index = <2>;

#undef TEGRA_SINTERFACE
#define TEGRA_SINTERFACE "serial_a"
#undef MODE_VC
#define MODE_VC "1"	

			LI_HAWK_10FPS
	
			ports {
				#address-cells = <1>;
				#size-cells = <0>;
				port@0 {
					reg = <0>;
					cam_out7: endpoint {
						vc-id = <1>;
						port-index = <0>;
						bus-width = <CAM_LANES>;
						remote-endpoint = <&csi_in7>;
					};
				};
			};	

		};
        };
    };
};
    i2c@3180000 {
		status = "okay";
		#address-cells = <1>;
		#size-cells = <0>;
		tca9539_74: tca9539@74 {
			compatible = "ti,tca9539";
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <16>;
			reg = <0x74>;
			vcc-supply = <&battery_reg>;
			status = "okay";
			
			tca9539_74_reset {
				status = "okay";
				gpio-hog;
				gpios = <0 0 2 0 4 0 6 0>;
				output-high;
				label = "RST_A","RST_B","RST_C","RST_D";
			};
			tca9539_74_pwdn {
				status = "okay";
                gpio-hog;
                gpios = <1 0 3 0 5 0 7 0>;
                output-low;
                label = "PWDN_A","PWDN_B","PWDN_C","PWDN_D";
			};
            
            tca9539_74_tp {
                status = "okay";
                gpios = < 8 0 9 0 10 0 11 0 12 0 13 0 14 0 15 0 >;
                input;
                label = "TP9", "TP10", "TP11", "TP12", "TP13", "TP14", "TP15", "TP16";
            };
			tca9539_74_input {
				status = "disabled";
			};
		};
	};
    tegra-capture-vi {
        status = "okay";
        num-channels = <8>;
        ports {
	    #address-cells = <1>;
	    #size-cells = <0>;
	    status = "okay";
            port@0 {
		        reg = <0>;
                status = "okay";
                vi_in0: endpoint {
		            vc-id = <0>;
                    port-index = <5>;
                    status = "okay";
                    bus-width = <CAM_LANES>;
		            remote-endpoint = <&csi_out0>;
                };
            };
            port@1 {
                status = "okay";
		        reg = <1>;
                vi_in1: endpoint {
		            vc-id = <1>;
                    port-index = <5>;
                    status = "okay";
                    bus-width = <CAM_LANES>;
		            remote-endpoint = <&csi_out1>;
                };
            };
            port@2 {
                status = "okay";
                reg = <2>;
                vi_in2: endpoint {
                    vc-id = <0>;
                    port-index = <4>;
                    status = "okay";
                    bus-width = <CAM_LANES>;
                    remote-endpoint = <&csi_out2>;
                };
            };
            port@3 {
                status = "okay";
                reg = <3>;
                vi_in3: endpoint {
                    vc-id = <1>;
                    port-index = <4>;
                    status = "okay";
                    bus-width = <CAM_LANES>;
                    remote-endpoint = <&csi_out3>;
                };
            };
	        port@4 {
		        status = "okay";
		        reg = <4>;
                vi_in4: endpoint {
                    vc-id = <0>;
                    port-index = <2>;
                    bus-width = <CAM_LANES>;
                    remote-endpoint = <&csi_out4>;
                    status = "okay";
                };
	        };
	        port@5 {
		        status = "okay";
		        reg = <5>;
                vi_in5: endpoint {
                    vc-id = <1>;
                    port-index = <2>;
                    bus-width = <CAM_LANES>;
                    remote-endpoint = <&csi_out5>;
                    status = "okay";
                };
	        };
            port@6{
                status = "okay";
                reg = <6>;
                vi_in6: endpoint {
                    vc-id = <0>;
                    port-index = <0>;
                    bus-width = <CAM_LANES>;
                    remote-endpoint = <&csi_out6>;
                    status = "okay";
                };
	        };
            port@7{
                status = "okay";
                reg = <7>;
                vi_in7: endpoint {
                    vc-id = <1>;
                    port-index = <0>;
                    bus-width = <CAM_LANES>;
                    remote-endpoint = <&csi_out7>;
                    status = "okay";
                };
	        };
        };
    };

    host1x@13e00000 {
        nvcsi@15a00000 {
	    num-channels = <8>;
	    #address-cells = <1>;
	    #size-cells = <0>;
            status = "okay";
            channel@0 {
                status = "okay";
		        reg = <0>;
                ports {
                    #address-cells = <1>;
                    #size-cells = <0>;
                    port@0 {
                        status = "okay";
			            reg = <0>;
                        csi_in0: endpoint@0 {
                            status = "okay";
                            port-index = <6>;
			                vc-id = <0>;
			                 bus-width = <CAM_LANES>;
                            remote-endpoint = <&cam_out0>;
                        };
                    };
                    port@1 {
                        status = "okay";
		            	reg = <1>;
                        csi_out0: endpoint@1 {
                            status = "okay";
                            port-index = <6>;
                            vc-id = <0>;
                            bus-width = <CAM_LANES>;
                            remote-endpoint = <&vi_in0>;
                        };
                    };
                };
            };
            channel@1 {
                status = "okay";
		        reg = <1>;
                ports {
                    #address-cells = <1>;
                    #size-cells = <0>;
                    port@0 {
                        status = "okay";
			            reg = <0>;
                        csi_in1: endpoint@2 {
                            status = "okay";
                            port-index = <6>;
			                vc-id = <1>;
			                 bus-width = <CAM_LANES>;
                            remote-endpoint = <&cam_out1>;
                        };
                    };
                    port@1 {
                        status = "okay";
		            	reg = <1>;
                        csi_out1: endpoint@3 {
                            status = "okay";
                            port-index = <6>;
                            vc-id = <1>;
                            bus-width = <CAM_LANES>;
                            remote-endpoint = <&vi_in1>;
                        };
                    };
                };
            };
            channel@2 {
                status = "okay";
		        reg = <2>;
                ports {
		            #address-cells = <1>;
		            #size-cells = <0>;
                    
		            port@0 {
			            reg = <0>;
                        status = "okay";
                        csi_in2: endpoint@3 {
                            status = "okay";
			                port-index = <4>;
			                vc-id = <0>;
                            bus-width = <CAM_LANES>;
                            remote-endpoint = <&cam_out2>;
                        };
                    };
                    port@1 {
                        status = "okay";
			            reg = <1>;
                        csi_out2: endpoint@4 {
                            status = "okay";
                            port-index = <4>;
                            vc-id = <0>;
                            bus-width = <CAM_LANES>;
                            remote-endpoint = <&vi_in2>;
                        };
                    };
                };
            };
            channel@3 {
                status = "okay";
		        reg = <3>;
                ports {
		            #address-cells = <1>;
		            #size-cells = <0>;
                    
		            port@0 {
			            reg = <0>;
                        status = "okay";
                        csi_in3: endpoint@5 {
                            status = "okay";
			                port-index = <4>;
			                vc-id = <1>;
                            bus-width = <CAM_LANES>;
                            remote-endpoint = <&cam_out3>;
                        };
                    };
                    port@1 {
                        status = "okay";
			            reg = <1>;
                        csi_out3: endpoint@6 {
                            status = "okay";
                            port-index = <4>;
                            vc-id = <1>;
                            bus-width = <CAM_LANES>;
                            remote-endpoint = <&vi_in3>;
                        };
                    };
                };
            };
            channel@4 {
                status = "okay";
		        reg = <4>;
                ports {
		            #address-cells = <1>;
		            #size-cells = <0>;
                    
		            port@0 {
			            reg = <0>;
                        status = "okay";
                        csi_in4: endpoint@7 {
                            status = "okay";
			                port-index = <2>;
			                vc-id = <0>;
                            bus-width = <CAM_LANES>;
                            remote-endpoint = <&cam_out4>;
                        };
                    };
                    port@1 {
                        status = "okay";
			            reg = <1>;
                        csi_out4: endpoint@8 {
                            status = "okay";
                            port-index = <2>;
                            vc-id = <0>;
                            bus-width = <CAM_LANES>;
                            remote-endpoint = <&vi_in4>;
                        };
                    };
                };
            };
            channel@5 {
                status = "okay";
		        reg = <5>;
                ports {
		            #address-cells = <1>;
		            #size-cells = <0>;
                    
		            port@0 {
			            reg = <0>;
                        status = "okay";
                        csi_in5: endpoint@9 {
                            status = "okay";
			                port-index = <2>;
			                vc-id = <1>;
                            bus-width = <CAM_LANES>;
                            remote-endpoint = <&cam_out5>;
                        };
                    };
                    port@1 {
                        status = "okay";
			            reg = <1>;
                        csi_out5: endpoint@10 {
                            status = "okay";
                            port-index = <2>;
                            vc-id = <1>;
                            bus-width = <CAM_LANES>;
                            remote-endpoint = <&vi_in5>;
                        };
                    };
                };
            };
            channel@6 {
                status = "okay";
		        reg = <6>;
                ports {
		            #address-cells = <1>;
		            #size-cells = <0>;
                    
		            port@0 {
			            reg = <0>;
                        status = "okay";
                        csi_in6: endpoint@11 {
                            status = "okay";
			                port-index = <0>;
			                vc-id = <0>;
                            bus-width = <CAM_LANES>;
                            remote-endpoint = <&cam_out6>;
                        };
                    };
                    port@1 {
                        status = "okay";
			            reg = <1>;
                        csi_out6: endpoint@12 {
                            status = "okay";
                            port-index = <0>;
                            vc-id = <0>;
                            bus-width = <CAM_LANES>;
                            remote-endpoint = <&vi_in6>;
                        };
                    };
                };
            };
            channel@7 {
                status = "okay";
		        reg = <7>;
                ports {
		            #address-cells = <1>;
		            #size-cells = <0>;
                    
		            port@0 {
			            reg = <0>;
                        status = "okay";
                        csi_in7: endpoint@13 {
                            status = "okay";
			                port-index = <0>;
			                vc-id = <1>;
                            bus-width = <CAM_LANES>;
                            remote-endpoint = <&cam_out7>;
                        };
                    };
                    port@1 {
                        status = "okay";
			            reg = <1>;
                        csi_out7: endpoint@14 {
                            status = "okay";
                            port-index = <0>;
                            vc-id = <1>;
                            bus-width = <CAM_LANES>;
                            remote-endpoint = <&vi_in7>;
                        };
                    };
                };
            };
        };
    };


    tegra-camera-platform {
        num_csi_lanes = <16>;
        max_lane_speed = <4000000>;
        min_bits_per_pixel = <10>;
        vi_peak_byte_per_pixel = <2>;
        vi_bw_margin_pct = <25>;
	//max_pixel_rate = <750000>;
        isp_peak_byte_per_pixel = <5>;
        isp_bw_margin_pct = <25>;
	compatible = "nvidia, tegra-camera-platform";
	status = "okay";
        
	modules {
		status = "okay";
		module0 {
			status = "okay";
			badge = "ar0234owl_bottomleft";
			position = "bottomleft";
			orientation = "1";
			drivernode0 {
				status = "okay";
				pcl_id = "v4l2_sensor";
				devname = "ar0234owl 30-0019";
				proc-device-tree = "/proc/device-tree/i2c@31e0000/tca9544@72/i2c@0/ar0234owl_a@19";
			};
			
		};
		module1 {
			status = "okay";
			badge = "ar0234owl_bottomright";
			position = "bottomright";
			orientation = "1";
			drivernode0 {
				status = "okay";
				pcl_id = "v4l2_sensor";
				devname = "ar0234owl 30-001a";
				proc-device-tree = "/proc/device-tree/i2c@31e0000/tca9544@72/i2c@0/ar0234owl_b@1a";	
			};
		};
		module2 {
			status = "okay";
			badge = "ar0234owl_topleft";
			position = "topleft";
			orientation = "1";
			drivernode0 {
				status = "okay";
