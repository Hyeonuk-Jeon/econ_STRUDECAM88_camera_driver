    tegra-camera-platform {
        num_csi_lanes = <16>;
        max_lane_speed = <4000000>;
        min_bits_per_pixel = <8>;
        vi_peak_byte_per_pixel = <1>;
        vi_bw_margin_pct = <25>;
	max_pixel_rate = <240000>;
        isp_peak_byte_per_pixel = <5>;
        isp_bw_margin_pct = <25>;
	compatible = "nvidia, tegra-camera-platform";
	status = "okay";
        
	modules {
		status = "okay";
		module0 {
			status = "okay";
			badge = "cti_front_cam";
			position = "front";
			orientation = "1";
			drivernode0 {
				status = "okay";
				pcl_id = "v4l2_sensor";
				devname = "imx390 40-001b";
				proc-device-tree = "/proc/device-tree/i2c@31e0000/tca9544@72/i2c@0/imx390_a@1b";
