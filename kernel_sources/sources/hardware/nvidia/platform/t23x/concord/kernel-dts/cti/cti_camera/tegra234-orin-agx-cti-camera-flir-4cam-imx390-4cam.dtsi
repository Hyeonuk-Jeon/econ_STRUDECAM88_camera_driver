				devname = "imx390 41-001c";
				proc-device-tree = "/proc/device-tree/i2c@31e0000/tca9544@72/i2c@1/imx390_d@1c";
			};
		};
		module4 {
			status = "okay";
			badge = "cti_centerleft";
			position = "centerleft";
			orientation = "1";
			drivernode0 {
				status = "okay";
				pcl_id = "v4l2_sensor";
				devname = "cti_boson 42-001b";
				proc-device-tree = "/proc/device-tree/i2c@31e0000/tca9544@72/i2c@2/cti_cam_c@1b";
			};
		};
		module5 {
			status = "okay";
			badge = "cti_centerright";
