            };

	    i2c@1 {
		status = "okay";
		reg = <1>;
		i2c-mux,deselect-on-exit;
		#address-cells = <1>;
		#size-cells = <0>;
		
		dserb: li_max9296@48 {
			compatible = "li,li_max9296";
			reg = <0x48>;
			csi-mode = "2x4";
			max-src = <2>;
			status = "okay";
			reset-gpios = <&tca9539_74 2 GPIO_ACTIVE_HIGH>;
		};
		ser_primb: li_max9295_prim@62 {
			compatible = "li,li_max9295";
			reg = <0x62>;
			is-prim-ser;
			status = "okay";
		};
		ser_a1: li_max9295_a@40 {
			compatible = "li,li_max9295";
			reg = <0x40>;
			nvidia,gmsl-dser-device = <&dserb>;
			status = "okay";
		};
		
		ser_b1: li_max9295_b@60 {
			compatible = "li,li_max9295";
			reg = <0x60>;
			nvidia,gmsl-dser-device = <&dserb>;
			status = "okay";
		};

		imx390_c@1b {
			def-addr = <0x21>;
			clocks = <&bpmp_clks TEGRA234_CLK_EXTPERIPH1>, <&bpmp_clks TEGRA234_CLK_EXTPERIPH1>;
			clock-names = "extperiph1", "pllp_grtba";
			mclk = "extperiph1";
			nvidia,gmsl-ser-device = <&ser_a1>;
			nvidia,gmsl-dser-device = <&dserb>;
			compatible = "li,imx390";
			reg = <0x1b>;
			reg_mux = <1>;

			physical_w = "15.0";
			physical_h = "12.5";
			sensor_model = "imx390";
			post_crop_frame_drop = "0";
			use_decibel_gain = "true";
			use_sensor_mode_id = "true";

			status = "okay";
			
			mode0 {
				IMX390_MODE0
				tegra_sinterface = "serial_e";
				num_lanes = "4";
				//mode_lanes = <4>;
				vc_id = "0";
			};

			ports {
				#address-cells = <1>;
				#size-cells = <0>;
				port@0{
					reg = <0>;
					cam_out2: endpoint {
						vc-id = <0>;
						port-index = <4>;
						bus-width = <CAM_LANES>;
						remote-endpoint = <&csi_in2>;

					};
				};
			};
			gmsl-link {
				src-csi-port = "b";
				dst-csi-port = "a";
				serdes-csi-link = "a";
				csi-mode = "1x4";
				st-vc = <0>;
				vc-id = <0>;
				num-lanes = <CAM_LANES>;
				streams = "ued-u1","raw12";

			};
		};

		imx390_d@1c {
			def-addr = <0x21>;
			clocks = <&bpmp_clks TEGRA234_CLK_EXTPERIPH1>, <&bpmp_clks TEGRA234_CLK_EXTPERIPH1>;
			clock-names = "extperiph1", "pllp_grtba";
			mclk = "extperiph1";
			compatible = "li,imx390";
			nvidia,gmsl-ser-device = <&ser_b1>;
			nvidia,gmsl-dser-device = <&dserb>;
			reg = <0x1c>;
			reg_mux = <1>;

			physical_w = "15.0";
			physical_h = "12.5";
			sensor_model = "imx390";
			post_crop_frame_drop = "0";
			use_decibel_gain = "true";
			use_sensor_mode_id = "true";

			status = "okay";
			mode0 {
				IMX390_MODE0
				tegra_sinterface = "serial_e";
				num_lanes = "4";
				//mode_lanes = <4>;
				vc_id = "1";
			};
			ports {
				#address-cells = <1>;
				#size-cells = <0>;
				port@0{
					reg = <0>;
					cam_out3: endpoint {
						vc-id = <0>;
						port-index = <4>;
						bus-width = <CAM_LANES>;
						remote-endpoint = <&csi_in3>;

					};
				};
			};
			gmsl-link {
				src-csi-port = "b";
				dst-csi-port = "a";
				serdes-csi-link = "b";
				csi-mode = "1x4";
				st-vc = <0>;
				vc-id = <1>;
				num-lanes = <CAM_LANES>;
				streams = "ued-u1","raw12";

			};
		};
