							};
						};
					};
				};
				cti_cam_b@1c {
					status = "okay";
					devnode = "video1";
					reg = <0x1c>;
					reset-gpios = <&tca9539_74 7 GPIO_ACTIVE_HIGH>;
					CTI_CAM_SENSOR_INFO
					
					mode0 {
						tegra_sinterface = "serial_a";
						vc_id = "1";
						CTI_CAM_MODE_0
					};

					ports {
						#address-cells = <1>;
						#size-cells = <0>;
						port@0{
							reg = <0>;
							cam_out7: endpoint {
								port-index = <0>;
								vc-id = <1>;
								bus-width = <4>;
								remote-endpoint = <&csi_in7>;
							};
						};
					};
				};
			};
			cti_max9295_A {
				reg = <0x42>;
				cti,def-addr = <0x42>;
				cti,lane-mode = <5>;
				cti,vc-id = <0>;
				cti,i2c-map = <0x1b 0x6c>;
				cti,pipes-dt = <0x2a 0 0 0>;

				ports {
					#address-cells = <1>;
					#size-cells = <0>;
					port@0 {
						reg = <0>;
