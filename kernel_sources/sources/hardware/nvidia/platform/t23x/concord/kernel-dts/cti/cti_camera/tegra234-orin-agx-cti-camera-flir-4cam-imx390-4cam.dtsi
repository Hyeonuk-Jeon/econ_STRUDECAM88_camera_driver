			orientation = "1";
			drivernode0 {
				status = "okay";
				pcl_id = "v4l2_sensor";
				devname = "cti_boson 42-001c";
				proc-device-tree = "/proc/device-tree/i2c@31e0000/tca9544@72/i2c@2/cti_cam_d@1c";
			};
		};
		module6 {
			status = "okay";
			badge = "cti_backleft";
