#include "dt-bindings/clock/tegra234-clock.h"

#define RST_IO_EXP TEGRA234_MAIN_GPIO(AC,1)
#define PWM_CALIB_GPIO TEGRA234_MAIN_GPIO(H,7) //CAM0_PWDN
#define TRIGGER_SEL TEGRA234_MAIN_GPIO(I,0) //CAM0_RST
#define PWR_EN		TEGRA234_MAIN_GPIO(AC, 7)
#define CAM_LANES 4
#define SERDES_PIX_CLK_HZ "750000000"
#define CIL_SETTLETIME "0"

#define CTI_CAM_SENSOR_INFO \
        compatible = "cti,boson"; \
        physical_w = "7.7"; \
        physical_h = "6.1"; \
        sensor_model = "boson"; \
        use_decibel_gain = "false"; \
        use_sensor_mode_id = "true"; \


#define CTI_CAM_MODE_0 \
        /*mclk_khz = "25000";*/ \
        mclk_khz = "25000"; \
	num_lanes = "4"; \
        phy_mode = "DPHY";\
        discontinuous_clk = "no"; \
	dpcm_enable = "false"; \
        cil_settletime = CIL_SETTLETIME; \
	mode_type = "raw"; \
        pixel_phase = "y"; \
        dynamic_pixel_bit_depth = "8"; \
        csi_pixel_bit_depth = "8"; \
        active_w = "640"; \
        active_h = "512"; \
        readout_orientation = "0"; \
        line_length = "750"; \
        pix_clk_hz = "27000000"; \
        serdes_pix_clk_hz = SERDES_PIX_CLK_HZ; \
        inherent_gain = "1"; \
        gain_factor = "1"; \
        min_gain_val = "1"; \
        max_gain_val = "15"; \
        default_gain = "7"; \
        step_gain_val = "1"; \
        framerate_factor = "1000000"; \
        min_framerate = "60000000"; \
        max_framerate = "60000000"; \
        step_framerate = "1"; \
        default_framerate = "60000000"; \
        exposure_factor = "1000000"; \
        min_exp_time = "17"; \
        max_exp_time = "17"; \
        default_exp_time = "17"; \
        step_exp_time = "1"; \
        min_hdr_ratio = "1"; \
        max_hdr_ratio = "1"; \
        embedded_metadata_height = "0"; \
                                        
#define IMX390_MODE0 \
		mclk_khz = "24000"; \
		discontinuous_clk = "no"; \
		dpcm_enable = "false"; \
		cil_settletime = "0"; \
		dynamic_pixel_bit_depth = "12"; \
		csi_pixel_bit_depth = "12"; \
		mode_type = "bayer"; \
		pixel_phase = "rggb"; \
		active_w = "1920"; \
		active_h = "1080"; \
		readout_orientation = "0"; \
		line_length = "2200"; \
		inherent_gain = "1"; \
		pix_clk_hz = "74250000"; \
		serdes_pix_clk_hz = "480000000"; \
		gain_factor = "10"; \
		min_gain_val = "0";  \
		max_gain_val = "300"; \
		step_gain_val = "3"; \
		default_gain = "0"; \
		min_hdr_ratio = "1"; \
		max_hdr_ratio = "1"; \
		framerate_factor = "1000000"; \
		min_framerate = "30000000"; \
		max_framerate = "30000000"; \
		step_framerate = "1"; \
		default_framerate = "30000000"; \
		exposure_factor = "1000000"; \
		min_exp_time = "118"; \
		max_exp_time = "33333"; \
		step_exp_time = "1"; \
		default_exp_time = "33333"; \
		embedded_metadata_height = "0"; \


/ {

	gpio@2200000 {
		camera-control-output-high {
			status = "okay";
			gpio-hog;
			gpios = <RST_IO_EXP 0>;
			output-high;
			label = "rst-io-expender"; 
		};
		camera-control-output-low {
			status = "okay";
			gpio-hog;
			gpios = <TRIGGER_SEL 0>;
			output-low;
			label = "trigger_sel";
		};
	};

	

    i2c@31e0000 {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;
        tca9544@72 {
	    status = "okay";
	    compatible = "nxp,pca9544";
	    reg = <0x72>;
	    #address-cells = <1>;
	    #size-cells = <0>;
	    vcc-supply = <&vdd_1v8_sys>;
	    vcc-pullup-supply = <&battery_reg>;
	    vcc_lp = "vcc";
	    skip_mux_detect = "yes";
	    force_bus_start = <40>;
            i2c@0 {
                status = "okay";
		reg = <0>;
		i2c-mux,deselect-on-exit;
		#address-cells = <1>;
		#size-cells = <0>;

		dsera: li_max9296@48 {
			compatible = "li,li_max9296";
			reg = <0x48>;
			csi-mode = "2x4";
			max-src = <2>;
			status = "okay";
			reset-gpios = <&tca9539_74 0 GPIO_ACTIVE_HIGH>;
			//reset-gpios
		};
		ser_prima: li_max9295_prim@62 {
			compatible = "li,li_max9295";
			reg = <0x62>;
			is-prim-ser;
			status = "okay";
		};
		ser_a0: li_max9295_a@40 {
			compatible = "li,li_max9295";
			reg = <0x40>;
			nvidia,gmsl-dser-device = <&dsera>;
			status = "okay";
		};
		
		ser_b0: li_max9295_b@60 {
			compatible = "li,li_max9295";
			reg = <0x60>;
			nvidia,gmsl-dser-device = <&dsera>;
			status = "okay";
		};

		imx390_a@1b {
			def-addr = <0x21>;
			clocks = <&bpmp_clks TEGRA234_CLK_EXTPERIPH1>, <&bpmp_clks TEGRA234_CLK_EXTPERIPH1>;
			clock-names = "extperiph1", "pllp_grtba";
			mclk = "extperiph1";
			nvidia,gmsl-ser-device = <&ser_a0>;
			nvidia,gmsl-dser-device = <&dsera>;
			compatible = "li,imx390";
			reg = <0x1b>;
			reg_mux = <0>;

			physical_w = "15.0";
			physical_h = "12.5";
			sensor_model = "imx390";
			post_crop_frame_drop = "0";
			use_decibel_gain = "true";
			use_sensor_mode_id = "true";

			status = "okay";
			
			mode0 {
				IMX390_MODE0
				tegra_sinterface = "serial_g";
				num_lanes = "4";
				//mode_lanes = <4>;
				vc_id = "0";
			};

			ports {
				#address-cells = <1>;
				#size-cells = <0>;
				port@0{
					reg = <0>;
					cam_out0: endpoint {
						vc-id = <0>;
						port-index = <6>;
						bus-width = <CAM_LANES>;
						remote-endpoint = <&csi_in0>;

					};
				};
			};
			gmsl-link {
				src-csi-port = "b";
				dst-csi-port = "a";
				serdes-csi-link = "a";
				csi-mode = "1x4";
				st-vc = <0>;
				vc-id = <0>;
				num-lanes = <CAM_LANES>;
				streams = "ued-u1","raw12";

			};
		};

		imx390_b@1c {
			def-addr = <0x21>;
			clocks = <&bpmp_clks TEGRA234_CLK_EXTPERIPH1>, <&bpmp_clks TEGRA234_CLK_EXTPERIPH1>;
			clock-names = "extperiph1", "pllp_grtba";
			mclk = "extperiph1";
			compatible = "li,imx390";
			nvidia,gmsl-ser-device = <&ser_b0>;
			nvidia,gmsl-dser-device = <&dsera>;
			reg = <0x1c>;
			reg_mux = <0>;

			physical_w = "15.0";
			physical_h = "12.5";
			sensor_model = "imx390";
			post_crop_frame_drop = "0";
			use_decibel_gain = "true";
			use_sensor_mode_id = "true";

			status = "okay";
			mode0 {
				IMX390_MODE0
				tegra_sinterface = "serial_g";
				num_lanes = "4";
				//mode_lanes = <4>;
				vc_id = "1";
			};
			ports {
				#address-cells = <1>;
				#size-cells = <0>;
				port@0{
					reg = <0>;
					cam_out1: endpoint {
						vc-id = <0>;
						port-index = <6>;
						bus-width = <CAM_LANES>;
						remote-endpoint = <&csi_in1>;

					};
				};
			};
			gmsl-link {
				src-csi-port = "b";
				dst-csi-port = "a";
				serdes-csi-link = "b";
				csi-mode = "1x4";
				st-vc = <0>;
				vc-id = <1>;
				num-lanes = <CAM_LANES>;
				streams = "ued-u1","raw12";

			};
		};

