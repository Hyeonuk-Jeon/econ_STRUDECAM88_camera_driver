				cti_cam_c@1b {
					status = "okay";
					devnode = "video2";
					reg = <0x1b>;
					reset-gpios = <&tca9539_74 4 GPIO_ACTIVE_HIGH>;
					CTI_CAM_SENSOR_INFO
					
					mode0 {
						tegra_sinterface = "serial_c";
						vc_id = "0";
						CTI_CAM_MODE_0
					};

					ports {
						#address-cells = <1>;
						#size-cells = <0>;
						port@0{
							reg = <0>;
							cam_out4: endpoint {
								port-index = <2>;
								vc-id = <0>;
								bus-width = <4>;
								remote-endpoint = <&csi_in4>;
							};
						};
					};
				};
				cti_cam_d@1c {
					status = "okay";
					devnode = "video3";
					reg = <0x1c>;
					reset-gpios = <&tca9539_74 5 GPIO_ACTIVE_HIGH>;
					CTI_CAM_SENSOR_INFO
					
					mode0 {
						tegra_sinterface = "serial_c";
						vc_id = "1";
						CTI_CAM_MODE_0
					};

					ports {
						#address-cells = <1>;
						#size-cells = <0>;
						port@0{
							reg = <0>;
							cam_out5: endpoint {
								port-index = <2>;
								vc-id = <1>;
								bus-width = <4>;
								remote-endpoint = <&csi_in5>;
							};
						};
					};
				};
			};
			cti_max9295_A {
				reg = <0x42>;
				cti,def-addr = <0x42>;
				cti,lane-mode = <5>;
				cti,vc-id = <0>;
				cti,i2c-map = <0x1b 0x6c>;
				cti,pipes-dt = <0x2a 0 0 0>;

				ports {
					#address-cells = <1>;
					#size-cells = <0>;
					port@0 {
						reg = <0>;
						cti_max9295_a2_in: endpoint {
							//remote-endpoint = <&cam_out0>;
						};
					};
					port@1 {
						reg = <1>;
						cti_max9295_a2_out: endpoint {
							//remote-endpoint = <&csi_in0>;
						};
					};
				};
			};
			cti_max9295_B {
				reg = <0x40>;
				cti,def-addr = <0x42>;
				cti,lane-mode = <5>;
				cti,vc-id = <1>;
				cti,i2c-map = <0x1c 0x6c>;
				cti,pipes-dt = <0 0x2a 0 0>;
				ports {
					#address-cells = <1>;
					#size-cells = <0>;
					port@0 {
						reg = <0>;
						cti_max9295_b2_in: endpoint {
							//remote-endpoint = <&cam_out1>;
						};
					};
					port@1 {
						reg = <1>;
						cti_max9295_b2_out: endpoint {
							//remote-endpoint = <&csi_in1>;
						};
					};
				};
			};

		};
		
		
            };
                
            i2c@3 {
                status = "okay";
		reg = <3>;
		i2c-mux,deselect-on-exit;
		#address-cells = <1>;
		#size-cells = <0>;
		max9296_3: cti_max9296@48 {
			#address-cells = <1>;
			#size-cells = <0>;
			compatible = "cti,max929x";
			reg = <0x48>;
			status = "okay";
			cti,csi-freq-mhz = <1500>;
			cti,dt-overrides = <0x2a 0x2a 0x0 0x0>;
			cti,bpp-overrides = <0x8 0x8 0x0 0x0>;
			cti,vc-overrides = <0 1 2 3>;
			cti,lane-mode = <1>;
			//cti,auto-deskew;	
			cti,always-on; 
			i2c@0 {
				#address-cells = <1>;
				#size-cells = <0>;
				reg = <0>;
				i2c-mux,deselect-on-exit;
				force_bus_start = <53>;
				
				cti_cam_a@1b {
					status = "okay";
